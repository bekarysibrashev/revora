// Revora_Обмен 1.3.0
// Серверный модуль. Рассчитывает компактные контрольные снимки непосредственно
// по данным 1С и отправляет их в Revora. Персональные данные пациентов не уходят.

Функция СинхронизироватьПериод(НачалоПериода, КонецПериода, АдресAPI, Токен) Экспорт

	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = КонецДня(КонецПериода);

	Снимки = Новый Массив;
	СнимокВыручки = СформироватьВыручкуПоУслугам(НачалоПериода, КонецПериода);
	СнимокОплат = СформироватьФактическиеПоступления(НачалоПериода, КонецПериода);
	СнимокЗарплаты = СформироватьЗарплату(НачалоПериода, КонецПериода);
	Снимки.Добавить(СнимокВыручки);
	Снимки.Добавить(СнимокОплат);
	Снимки.Добавить(СформироватьВыручкуПоВрачам(НачалоПериода, КонецПериода));
	Снимки.Добавить(СнимокЗарплаты);
	Снимки.Добавить(СформироватьПоступления(НачалоПериода, КонецПериода));
	Снимки.Добавить(СформироватьПациентов(НачалоПериода, КонецПериода));
	Снимки.Добавить(СформироватьЗаписи(НачалоПериода, КонецПериода));

	Для Каждого Снимок Из Снимки Цикл
		ОтправитьСнимок(АдресAPI, Токен, Снимок);
	КонецЦикла;

	// Контрольные снимки выше подтверждают официальный итог выбранного периода.
	// Дополнительно отправляем дневные агрегаты: из них Revora сможет честно
	// собрать любой вложенный диапазон, не распределяя месячную сумму на глаз.
	ДневныхСнимков = 0;
	ПакетДней = Новый Массив;
	ТекущийДень = НачалоПериода;
	Пока ТекущийДень <= КонецПериода Цикл
		КонецТекущегоДня = КонецДня(ТекущийДень);
		ПакетДней.Добавить(СформироватьВыручкуПоУслугам(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьФактическиеПоступления(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьВыручкуПоВрачам(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьПоступления(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьПациентов(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьЗаписи(ТекущийДень, КонецТекущегоДня));
		ДневныхСнимков = ДневныхСнимков + 6;

		Если ПакетДней.Количество() >= 24 Тогда
			ОтправитьПакетСнимков(АдресAPI, Токен, ПакетДней);
			ПакетДней = Новый Массив;
		КонецЕсли;
		ТекущийДень = НачалоДня(ТекущийДень + 24 * 60 * 60);
	КонецЦикла;
	Если ПакетДней.Количество() > 0 Тогда
		ОтправитьПакетСнимков(АдресAPI, Токен, ПакетДней);
	КонецЕсли;

	Возврат Новый Структура("Выручка,Оплата,Зарплата,ВерсияСервера,РазрезыОплаты,ДневныхСнимков",
		ЗначениеМетрикиКлиники(СнимокВыручки, "revenue_accrual"),
		ЗначениеМетрикиКлиники(СнимокОплат, "revenue_payment"),
		ЗначениеМетрикиКлиники(СнимокЗарплаты, "payroll_accrual"),
		"1.2.0-server", СнимокОплат.summary.breakdowns_reconciled, ДневныхСнимков);

КонецФункции

Функция СформироватьВыручкуПоУслугам(НачалоПериода, КонецПериода)

	// Берем запрос непосредственно из того же отчета, который сотрудники
	// формируют в 1С: «Оказанные услуги, продажи по пациентам».
	ОбъектОтчета = Отчеты.ОказанныеУслугиПоВрачу.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	ТекстЗапроса = Схема.НаборыДанных.Найти("Запрос").Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Обороты(, , Авто,",
		"Обороты(&НачалоПериода, &КонецПериода, Авто,");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	// Верхняя граница виртуальной таблицы оборотов исключающая. Передаем
	// начало следующего дня, чтобы движения в 23:59:59 последнего дня не терялись.
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	Специализации = Новый Соответствие;
	ИтогоКоличество = 0;
	ИтогоСтоимость = 0;
	ИтогоБезСкидки = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Специализация = Выборка.Номенклатура.Специализация;
		КлючСпециализации = КлючСсылки(Специализация);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Группа.Количество = Группа.Количество + Число0(Выборка.Количество);
		Группа.Сумма = Группа.Сумма + Число0(Выборка.Стоимость);
		Группа.БезСкидки = Группа.БезСкидки + Число0(Выборка.ЦенаБезСкидки);
		ИтогоКоличество = ИтогоКоличество + Число0(Выборка.Количество);
		ИтогоСтоимость = ИтогоСтоимость + Число0(Выборка.Стоимость);
		ИтогоБезСкидки = ИтогоБезСкидки + Число0(Выборка.ЦенаБезСкидки);

		СоставнойКлюч = КлючФилиала + "|" + КлючСпециализации;
		ГруппаСпециализации = ПолучитьГруппу(Специализации, СоставнойКлюч, Строка(Специализация));
		ГруппаСпециализации.Количество = ГруппаСпециализации.Количество + Число0(Выборка.Количество);
		ГруппаСпециализации.Сумма = ГруппаСпециализации.Сумма + Число0(Выборка.Стоимость);
	КонецЦикла;

	Для Каждого Элемент Из Специализации Цикл
		ЧастиКлюча = СтрРазделить(Элемент.Ключ, "|");
		КлючФилиала = ЧастиКлюча[0];
		КлючСпециализации = ЧастиКлюча[1];
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "services_count", "specialty", КлючСпециализации,
			Группа.Наименование, Группа.Количество, "count", КлючФилиала);
		ДобавитьМетрику(Метрики, "revenue_accrual", "specialty", КлючСпециализации,
			Группа.Наименование, Группа.Сумма, "KZT", КлючФилиала);
	КонецЦикла;

	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "services_count", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Количество, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "revenue_accrual", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "revenue_before_discount", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.БезСкидки, "KZT", Элемент.Ключ);
	КонецЦикла;

	// Общий итог берем из результата штатной СКД. Именно этот путь использует
	// экранный отчет 1С; прямой Запрос не воспроизводит его итог полностью.
	ИтогоСтоимость = ПолучитьИтогВыручкиИзШтатногоОтчета(НачалоПериода, КонецПериода);
	ДобавитьМетрику(Метрики, "services_count", "clinic", "clinic", "Вся клиника", ИтогоКоличество, "count");
	ДобавитьМетрику(Метрики, "revenue_accrual", "clinic", "clinic", "Вся клиника", ИтогоСтоимость, "KZT");
	ДобавитьМетрику(Метрики, "revenue_before_discount", "clinic", "clinic", "Вся клиника", ИтогоБезСкидки, "KZT");
	Возврат НовыйСнимок("service_revenue", НачалоПериода, КонецПериода, Метрики);

КонецФункции

Функция СформироватьФактическиеПоступления(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредстваОбороты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ДенежныеСредстваОбороты.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ДенежныеСредстваОбороты.ТипДенежныхСредств КАК ТипДенежныхСредств,
	|	СУММА(ДенежныеСредстваОбороты.СуммаОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		Авто,
	|		ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ПлатежнаяКарта)
	|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)) КАК ДенежныеСредстваОбороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.ПоступлениеДенежныхСредств
	|				ТОГДА ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ОплатаОтКлиента)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВзносНаЛицевойСчет)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.ПеремещениеДенежныхСредств
	|	И ВЫБОР
	|			КОГДА ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.СписаниеДенежныхСредств
	|				ТОГДА ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОплатыКлиенту)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратСЛицевогоСчета)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОшибочнойОплатыКлиенту)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредстваОбороты.СтруктурнаяЕдиница,
	|	ДенежныеСредстваОбороты.БанковскийСчетКасса,
	|	ДенежныеСредстваОбороты.ТипДенежныхСредств";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	СпособыОплаты = Новый Соответствие;
	ФилиалыСпособов = Новый Соответствие;
	СчетаКассы = Новый Соответствие;
	ФилиалыСчетов = Новый Соответствие;
	Итого = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаСтроки = Число0(Выборка.Сумма);
		Итого = Итого + СуммаСтроки;
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Если КлючФилиала = "empty" Тогда Продолжить; КонецЕсли;
		ДобавитьКГруппе(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница), СуммаСтроки);

		КлючСпособа = КлючФилиала + "|" + КлючСсылки(Выборка.ТипДенежныхСредств);
		ДобавитьКГруппе(СпособыОплаты, КлючСпособа, Строка(Выборка.ТипДенежныхСредств), СуммаСтроки);
		ФилиалыСпособов.Вставить(КлючСпособа, КлючФилиала);

		КлючСчета = КлючФилиала + "|" + КлючСсылки(Выборка.БанковскийСчетКасса);
		ДобавитьКГруппе(СчетаКассы, КлючСчета, Строка(Выборка.БанковскийСчетКасса), СуммаСтроки);
		ФилиалыСчетов.Вставить(КлючСчета, КлючФилиала);
	КонецЦикла;

	ИтогоОтчета = ПолучитьИтогОплатыИзШтатногоОтчета(НачалоПериода, КонецПериода);
	РазницаИтогов = Итого - ИтогоОтчета;
	Если РазницаИтогов < 0 Тогда РазницаИтогов = -РазницаИтогов; КонецЕсли;
	РазрезыСогласованы = РазницаИтогов < 0.01;
	Если РазрезыСогласованы Тогда
		Для Каждого Элемент Из Филиалы Цикл
			ДобавитьМетрику(Метрики, "revenue_payment", "branch", Элемент.Ключ,
				Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", Элемент.Ключ);
		КонецЦикла;
		Для Каждого Элемент Из СпособыОплаты Цикл
			ДобавитьМетрику(Метрики, "cash_inflow", "payment_method", Элемент.Ключ,
				Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", ФилиалыСпособов.Получить(Элемент.Ключ));
		КонецЦикла;
		Для Каждого Элемент Из СчетаКассы Цикл
			ДобавитьМетрику(Метрики, "cash_inflow", "cash_account", Элемент.Ключ,
				Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", ФилиалыСчетов.Получить(Элемент.Ключ));
		КонецЦикла;
	КонецЕсли;
	Итого = ИтогоОтчета;
	ДобавитьМетрику(Метрики, "revenue_payment", "clinic", "clinic", "Вся клиника", Итого, "KZT");
	ДобавитьМетрику(Метрики, "cash_inflow", "clinic", "clinic", "Вся клиника", Итого, "KZT");

	// Task 2: refunds as their own line item. revenue_payment/cash_inflow
	// above already net refunds out of the receipt totals (correct for
	// "cash actually received") -- this is a SEPARATE, additive query so a
	// mistake here can never corrupt the already-reconciled receipt figures
	// above. Best-effort and isolated: if this configuration's refund
	// operation types don't match, the metric is simply not sent (never a
	// guessed number) rather than breaking the whole snapshot.
	Попытка
		ЗапросВозвратов = Новый Запрос;
		ЗапросВозвратов.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ДенежныеСредстваОбороты.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Обороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		Авто,
		|		ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
		|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ПлатежнаяКарта)
		|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)) КАК ДенежныеСредстваОбороты
		|ГДЕ
		|	ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.СписаниеДенежныхСредств
		|	И (ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОплатыКлиенту)
		|		ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратСЛицевогоСчета)
		|		ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОшибочнойОплатыКлиенту))";
		ЗапросВозвратов.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросВозвратов.УстановитьПараметр("КонецПериода", КонецПериода);
		ВыборкаВозвратов = ЗапросВозвратов.Выполнить().Выбрать();
		Если ВыборкаВозвратов.Следующий() Тогда
			// Sign convention for write-off turnover isn't guaranteed across
			// configurations -- take the magnitude, since "refunds" is only
			// ever meaningful as a positive amount returned to a patient.
			ИтогоВозвратов = Число0(ВыборкаВозвратов.Сумма);
			Если ИтогоВозвратов < 0 Тогда
				ИтогоВозвратов = -ИтогоВозвратов;
			КонецЕсли;
			ДобавитьМетрику(Метрики, "refunds", "clinic", "clinic", "Вся клиника", ИтогоВозвратов, "KZT");
		КонецЕсли;
	Исключение
		// Configuration-specific enum/document mismatch -- skip refunds for
		// this sync rather than sending a guessed or broken figure.
	КонецПопытки;

	Снимок = НовыйСнимок("cash_receipts", НачалоПериода, КонецПериода, Метрики);
	Снимок.summary.Вставить("breakdowns_reconciled", РазрезыСогласованы);
	Возврат Снимок;

КонецФункции

Функция СформироватьВыручкуПоВрачам(НачалоПериода, КонецПериода)

	ОбъектОтчета = Отчеты.АнализОплатПоВрачам.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НаборДанных = Схема.НаборыДанных.Найти("НаборДанных1");
	ТекстЗапроса = НаборДанных.Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"ОстаткиИОбороты(, , Авто, ,", "ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Авто, ,");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Врачи = Новый Соответствие;
	Филиалы = Новый Соответствие;
	Итого = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		КлючВрача = КлючСсылки(Выборка.Врач);
		Сумма = Число0(Выборка.Всего);
		Итого = Итого + Сумма;
		ДобавитьКГруппе(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница), Сумма);
		СоставнойКлюч = КлючФилиала + "|" + КлючВрача;
		Если Врачи.Получить(СоставнойКлюч) = Неопределено Тогда
			Врачи.Вставить(СоставнойКлюч, Новый Структура("Ключ,Наименование,КлючФилиала,Сумма",
				КлючВрача, Строка(Выборка.Врач), КлючФилиала, 0));
		КонецЕсли;
		ГруппаВрача = Врачи.Получить(СоставнойКлюч);
		ГруппаВрача.Сумма = ГруппаВрача.Сумма + Сумма;
	КонецЦикла;

	Для Каждого Элемент Из Филиалы Цикл
		ДобавитьМетрику(Метрики, "doctor_revenue_payment", "branch", Элемент.Ключ,
			Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", Элемент.Ключ);
	КонецЦикла;
	Для Каждого Элемент Из Врачи Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "doctor_revenue_payment", "doctor", Группа.Ключ,
			Группа.Наименование, Группа.Сумма, "KZT", Группа.КлючФилиала);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "doctor_revenue_payment", "clinic", "clinic", "Вся клиника", Итого, "KZT");
	Возврат НовыйСнимок("doctor_revenue", НачалоПериода, КонецПериода, Метрики);

