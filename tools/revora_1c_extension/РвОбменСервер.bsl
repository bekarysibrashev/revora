// Revora_Обмен 1.8.3.0
// Серверный модуль. Рассчитывает компактные контрольные снимки непосредственно
// по данным 1С и отправляет их в Revora. Телефоны передаются только как SHA-256;
// ФИО остаётся внутри защищённого контура клиники Revora.

// Единственное место, где живёт номер версии расширения. Каждое место,
// которому раньше требовалась версия отдельной строкой ("1.2.0", "1.3.0-server",
// "Revora 1.3.0 (сервер ...)" в форме настроек), должно вызывать эту функцию,
// а не хранить свой собственный литерал -- отдельные литералы в разных
// местах разошлись один раз (summary.extension_version отстал на одну
// версию) и должны быть невозможны впредь.
Функция ВерсияРасширения() Экспорт
	Возврат "1.8.3.0";
КонецФункции

// Единое текстовое представление результата СинхронизироватьПериод --
// используется и ручной синхронизацией из формы настроек, и регламентным
// заданием почасовой синхронизации (см. РвПочасоваяСинхронизация), чтобы
// формулировка нигде не разошлась и результат обеих всегда был одинаково
// подробным. ИСПРАВЛЕНО (ревизия v18): раньше единственной информацией о
// разрезах было "разрезы оплат: сверены / не отправлены" -- вторая часть
// была неверна в реальности (разрезы как раз отправлялись, но не сверились
// день в день) и вводила в заблуждение. Теперь "не отправлены" пишется
// только когда набор действительно пуст, а не просто не сошелся до копейки.
Функция ПредставлениеИтоговСинхронизации(Итоги) Экспорт
	Текст = "Revora " + ВерсияРасширения() + " (сервер " + Итоги.ВерсияСервера + ")." + Символы.ПС
		+ "Контрольных снимков: " + Строка(Итоги.КонтрольныхСнимков)
		+ "; дневных снимков: " + Строка(Итоги.ДневныхСнимков) + "." + Символы.ПС
		+ "Пациентов: " + Строка(Итоги.Пациенты)
		+ "; врачей: " + Строка(Итоги.Врачи)
		+ "; направлений: " + Строка(Итоги.Направлений)
		+ "; записей: " + Строка(Итоги.Записи)
		+ "; расходов: " + Строка(Итоги.Расходы) + "." + Символы.ПС;

	Если Итоги.РазрезыОплатыСтрок = 0 Тогда
		Текст = Текст + "Разрезы оплаченной выручки: не отправлены (за период нет движений денежных средств).";
	Иначе
		Текст = Текст + "Разрезы оплаченной выручки: " + Строка(Итоги.РазрезыОплатыСтрок)
			+ ?(Итоги.РазрезыОплаты, " (сверены с итогом клиники)",
				" (отправлены; расхождение с итогом клиники: " + Формат(Итоги.РазрезыОплатыРазница, "ЧДЦ=2") + ")");
	КонецЕсли;
	Текст = Текст + Символы.ПС;

	Если Итоги.РазрезыНачисленийОшибка Тогда
		Текст = Текст + "Разрезы начисленной выручки по врачам: не удалось получить в этот раз"
			+ " (структура регистра Продажи могла измениться -- контрольный итог выручки не пострадал).";
	ИначеЕсли Итоги.РазрезыНачисленийСтрок = 0 Тогда
		Текст = Текст + "Разрезы начисленной выручки по врачам: не отправлены (за период нет движений в регистре Продажи).";
	Иначе
		РазницаНачисл = Итоги.РазрезыНачисленийРазница;
		Текст = Текст + "Разрезы начисленной выручки по врачам: " + Строка(Итоги.РазрезыНачисленийСтрок)
			+ ?(РазницаНачисл < 0.01, " (сверены с итогом клиники)",
				" (отправлены; расхождение с итогом клиники: " + Формат(РазницаНачисл, "ЧДЦ=2") + ")");
	КонецЕсли;

	Если Итоги.ОперационныхОтклонено > 0 Тогда
		Текст = Текст + Символы.ПС + "Внимание: сервер отклонил " + Строка(Итоги.ОперационныхОтклонено)
			+ " операционных записей. Остальные приняты и не откатываются; отклоненные будут"
			+ " повторно отправлены при следующей синхронизации (отправка идемпотентна).";
		Если Итоги.Свойство("ОперационныхПричины") И Итоги.ОперационныхПричины <> Неопределено
				И Итоги.ОперационныхПричины.Количество() > 0 Тогда
			Текст = Текст + Символы.ПС + "Причины (до 5 из " + Строка(Итоги.ОперационныхПричины.Количество()) + "):";
			ПоказаноПричин = 0;
			Для Каждого Причина Из Итоги.ОперационныхПричины Цикл
				Если ПоказаноПричин >= 5 Тогда
					Прервать;
				КонецЕсли;
				Текст = Текст + Символы.ПС + " - " + Причина;
				ПоказаноПричин = ПоказаноПричин + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;
КонецФункции


Функция СинхронизироватьПериод(НачалоПериода, КонецПериода, АдресAPI, Токен) Экспорт

	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = КонецДня(КонецПериода);

	Снимки = Новый Массив;
	СнимокВыручки = СформироватьВыручкуПоУслугам(НачалоПериода, КонецПериода);
	СнимокОплат = СформироватьФактическиеПоступления(НачалоПериода, КонецПериода);
	СнимокЗарплаты = СформироватьЗарплату(НачалоПериода, КонецПериода);
	Снимки.Добавить(СнимокВыручки);
	Снимки.Добавить(СнимокОплат);
	Снимки.Добавить(СформироватьВыручкуПоВрачам(НачалоПериода, КонецПериода));
	Снимки.Добавить(СнимокЗарплаты);
	Снимки.Добавить(СформироватьПоступления(НачалоПериода, КонецПериода));
	Снимки.Добавить(СформироватьПациентов(НачалоПериода, КонецПериода));
	Снимки.Добавить(СформироватьЗаписи(НачалоПериода, КонецПериода));

	Для Каждого Снимок Из Снимки Цикл
		ОтправитьСнимок(АдресAPI, Токен, Снимок);
	КонецЦикла;

	// Детальные сущности идут отдельным идемпотентным потоком. Официальные
	// контрольные снимки выше и их формулы при этом не изменяются.
	ОперационныеИтоги = СинхронизироватьОперационныеДанные(НачалоПериода, КонецПериода, АдресAPI, Токен);

	// Контрольные снимки выше подтверждают официальный итог выбранного периода.
	// Дополнительно отправляем дневные агрегаты: из них Revora сможет честно
	// собрать любой вложенный диапазон, не распределяя месячную сумму на глаз.
	ДневныхСнимков = 0;
	ПакетДней = Новый Массив;
	ТекущийДень = НачалоПериода;
	Пока ТекущийДень <= КонецПериода Цикл
		КонецТекущегоДня = КонецДня(ТекущийДень);
		ПакетДней.Добавить(СформироватьВыручкуПоУслугам(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьФактическиеПоступления(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьВыручкуПоВрачам(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьПоступления(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьПациентов(ТекущийДень, КонецТекущегоДня));
		ПакетДней.Добавить(СформироватьЗаписи(ТекущийДень, КонецТекущегоДня));
		ДневныхСнимков = ДневныхСнимков + 6;

		Если ПакетДней.Количество() >= 24 Тогда
			ОтправитьПакетСнимков(АдресAPI, Токен, ПакетДней);
			ПакетДней = Новый Массив;
		КонецЕсли;
		ТекущийДень = НачалоДня(ТекущийДень + 24 * 60 * 60);
	КонецЦикла;
	Если ПакетДней.Количество() > 0 Тогда
		ОтправитьПакетСнимков(АдресAPI, Токен, ПакетДней);
	КонецЕсли;

	// ИСПРАВЛЕНО (ревизия v18): наблюдаемость синхронизации -- вместо одной
	// туманной фразы "разрезы оплат не отправлены" форма настроек теперь
	// может честно показать отдельно пациентов/врачей/направлений/записей/
	// расходов/контрольных и дневных снимков/разрезов оплаченной и
	// начисленной выручки/отклоненных сервером записей. Ни одно из значений
	// ниже не выдумано -- каждое взято из фактического результата отправки
	// этой же самой синхронизации.
	Результат = Новый Структура;
	Результат.Вставить("Выручка", ЗначениеМетрикиКлиники(СнимокВыручки, "revenue_accrual"));
	Результат.Вставить("Оплата", ЗначениеМетрикиКлиники(СнимокОплат, "revenue_payment"));
	Результат.Вставить("Зарплата", ЗначениеМетрикиКлиники(СнимокЗарплаты, "payroll_accrual"));
	Результат.Вставить("ВерсияСервера", ВерсияРасширения() + "-server");
	Результат.Вставить("РазрезыОплаты", СнимокОплат.summary.breakdowns_reconciled);
	Результат.Вставить("РазрезыОплатыСтрок", СнимокОплат.summary.breakdowns_sent);
	Результат.Вставить("РазрезыОплатыРазница", СнимокОплат.summary.breakdowns_reconciliation_diff);
	Результат.Вставить("РазрезыНачисленийСтрок", СнимокВыручки.summary.doctor_accrual_rows);
	Результат.Вставить("РазрезыНачисленийОшибка", СнимокВыручки.summary.doctor_accrual_query_failed);
	Результат.Вставить("РазрезыНачисленийРазница", СнимокВыручки.summary.doctor_accrual_reconciliation_diff);
	Результат.Вставить("КонтрольныхСнимков", Снимки.Количество());
	Результат.Вставить("ДневныхСнимков", ДневныхСнимков);
	Результат.Вставить("Пациенты", ОперационныеИтоги.Пациенты);
	Результат.Вставить("Врачи", ОперационныеИтоги.Врачи);
	Результат.Вставить("Направлений", ОперационныеИтоги.Направлений);
	Результат.Вставить("Записи", ОперационныеИтоги.Записи);
	Результат.Вставить("Расходы", ОперационныеИтоги.Расходы);
	Результат.Вставить("ОперационныхОтклонено", ОперационныеИтоги.ВсегоОтклонено);
	Результат.Вставить("ОперационныхПричины", ОперационныеИтоги.ПричиныОтклонения);
	Возврат Результат;

КонецФункции


// НОВОЕ (ревизия v18): почасовая автоматическая синхронизация.
//
// Вызывается регламентным заданием РвПочасоваяСинхронизация (по умолчанию
// выключено -- см. README, раздел "Автоматическая синхронизация"). Ручная
// синхронизация из формы настроек продолжает работать полностью независимо
// от этой процедуры и ничего в ней не меняет.
//
// Гарантии:
//   - не пытается угадать адрес API/токен -- если ручная синхронизация
//     ни разу не запускалась (нет сохраненных настроек), просто выходит;
//   - защита от параллельного запуска: если предыдущий запуск начался
//     менее ДвухЧасов назад и еще не завершился (нет отметки о завершении),
//     новый запуск не начинается -- защищает от наложения, если один прогон
//     почему-то выполняется дольше часового расписания;
//   - инкрементальный период с перекрытием: начало периода = конец
//     предыдущего успешного периода МИНУС 3 часа перекрытия (чтобы события,
//     записанные в 1С с небольшой задержкой относительно своего времени, не
//     потерялись на границе часа) -- благодаря идемпотентности снимков по
//     периоду и операционных записей по GUID повторная отправка перекрытых
//     часов не создает дублей и не портит агрегаты;
//   - первый автоматический запуск (нет сохраненного "последнего успешного
//     конца") берет только последние 6 часов, а не всю историю с начала
//     времен -- первоначальная историческая загрузка остается ручной
//     операцией через форму настроек, как и требуется;
//   - сбой сети/сервера Render (таймаут HTTPСоединение уже 300 секунд,
//     см. ОтправитьСнимок/ОтправитьПакетОперационныхДанных) ловится здесь,
//     пишется в журнал регистрации и в Хранилище системных настроек, и НЕ
//     продвигает "последний успешный конец" -- значит период с ошибкой
//     будет естественным образом повторен следующим часовым запуском;
//   - токен никогда не попадает в текст журнала регистрации или в
//     сохраняемую Структуру журнала синхронизации -- туда идет только
//     готовое текстовое сообщение (см. ПредставлениеИтоговСинхронизации),
//     которое токен не содержит.
// Продолжительность аренды блокировки почасовой синхронизации.
// ИСПРАВЛЕНО (ревизия v18.1, задача 6): раньше "блокировкой" была метка
// времени "НачатоВ" в ХранилищеСистемныхНастроек, а "занято" проверялось
// эвристикой "прошло меньше 2 часов с начала" -- если процесс падал
// посреди прогона, синхронизация оставалась заблокированной вплоть до
// 2 часов. Теперь это настоящая аренда (lease) с явным временем истечения
// (ЗахваченоДо), которое снимается при нормальном завершении (как и
// раньше) и само истекает через 45 минут, если снять его не удалось --
// с большим запасом относительно обычной длительности инкрементального
// прогона (секунды-минуты), но существенно короче прежних 2 часов.
//
// Честно о гарантиях: стандартный планировщик регламентных заданий 1С на
// одной информационной базе сам не запускает второй экземпляр ОДНОГО и
// того же регламентного задания, пока предыдущий еще выполняется -- это
// покрывает штатный случай "два часовых запуска подряд". Эта аренда --
// дополнительный, а не единственный, рубеж защиты для случаев, которые
// платформа сама не гарантирует: ручной вызов ВыполнитьРегламентнуюСинхронизацию
// из Конфигуратора/Предприятия во время автоматического прогона,
// распределенные базы (РИБ) с независимыми планировщиками, и поведение
// кластера с несколькими рабочими процессами -- ни один из этих случаев
// не проверялся на реальном кластере. Чтение и запись
// ХранилищеСистемныхНастроек ниже -- НЕ атомарная операция уровня СУБД
// (это не БлокировкаДанных): при двух одновременных попытках захвата в
// пределах одной и той же миллисекунды теоретически возможна гонка. Более
// строгая гарантия потребовала бы отдельного объекта метаданных
// (Информационный регистр + управляемая БлокировкаДанных), что нельзя
// проверить без реального Конфигуратора -- см. README, раздел про задачу 6.
Функция РвДлительностьАрендыСекунд()
	Возврат 45 * 60;
КонецФункции

Процедура ВыполнитьРегламентнуюСинхронизацию() Экспорт
	Попытка
		Настройки = ХранилищеСистемныхНастроек.Загрузить("Revora/Обмен");
		Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
			РвЗаписатьЖурналПочасовойСинхронизации(
				"Пропущено: ручная синхронизация ни разу не запускалась, адрес API и токен не настроены.", Ложь);
			Возврат;
		КонецЕсли;

		АдресAPI = "";
		Токен = "";
		Настройки.Свойство("АдресAPI", АдресAPI);
		Настройки.Свойство("Токен", Токен);
		Если ПустаяСтрока(СокрЛП(АдресAPI)) Или ПустаяСтрока(СокрЛП(Токен)) Тогда
			РвЗаписатьЖурналПочасовойСинхронизации(
				"Пропущено: не настроен адрес API или токен коннектора.", Ложь);
			Возврат;
		КонецЕсли;

		Журнал = ХранилищеСистемныхНастроек.Загрузить("Revora/ПочасоваяСинхронизация");
		Если ТипЗнч(Журнал) <> Тип("Структура") Тогда
			Журнал = Новый Структура;
		КонецЕсли;

		ЗахваченоДо = Неопределено;
		Журнал.Свойство("ЗахваченоДо", ЗахваченоДо);
		Если ЗахваченоДо <> Неопределено И ТекущаяДата() < ЗахваченоДо Тогда
			РвЗаписатьЖурналПочасовойСинхронизации(
				"Пропущено: предыдущий автоматический запуск еще выполняется (блокировка действует до "
				+ Формат(ЗахваченоДо, "ДФ=yyyy-MM-dd HH:mm:ss") + ").", Ложь);
			Возврат;
		КонецЕсли;

		Журнал.Вставить("ЗахваченоДо", ТекущаяДата() + РвДлительностьАрендыСекунд());
		ХранилищеСистемныхНастроек.Сохранить("Revora/ПочасоваяСинхронизация",, Журнал);

		// started_at/finished_at/range/accepted/rejected/error -- полный
		// журнал каждого прогона для наблюдаемости (задача 6), без токена и
		// без персональных данных.
		НачатоВ = ТекущаяДата();
		Журнал.Вставить("ПоследнийЗапущенВ", НачатоВ);

		ПоследнийУспешныйКонец = Неопределено;
		Журнал.Свойство("ПоследнийУспешныйКонец", ПоследнийУспешныйКонец);
		Если ПоследнийУспешныйКонец = Неопределено Тогда
			НачалоПериода = ТекущаяДата() - 6 * 60 * 60;
		Иначе
			НачалоПериода = ПоследнийУспешныйКонец - 3 * 60 * 60;
		КонецЕсли;
		КонецПериода = ТекущаяДата();
		Если НачалоПериода > КонецПериода Тогда
			НачалоПериода = КонецПериода;
		КонецЕсли;

		Журнал.Вставить("ПоследнийДиапазон", Формат(НачалоПериода, "ДФ=yyyy-MM-dd HH:mm:ss")
			+ " — " + Формат(КонецПериода, "ДФ=yyyy-MM-dd HH:mm:ss"));

		Попытка
			Итоги = СинхронизироватьПериод(НачалоПериода, КонецПериода, АдресAPI, Токен);
			// ИСПРАВЛЕНО (ревизия v18.1, задача 5): раньше отсутствие
			// исключения означало "полный успех" -- ПоследнийУспешныйКонец
			// сдвигался, даже если сервер реально отклонил часть записей
			// (Итоги.ОперационныхОтклонено > 0). Отклоненные записи никогда
			// не приходили автоматически повторно, потому что watermark уже
			// прошел мимо них. Теперь статус прогона -- три состояния:
			// succeeded (ничего не отклонено -- watermark сдвигается),
			// partial (запрос выполнен, но что-то отклонено -- watermark
			// НЕ сдвигается; повторная отправка безопасна благодаря
			// идемпотентности сервера, поэтому уже принятые записи не
			// откатываются и не дублируются при следующем прогоне) и
			// failed (см. Исключение ниже -- тоже не сдвигает watermark).
			// "Принято" здесь -- операционные записи, обработанные этим прогоном
			// (пациенты+врачи+записи+расходы, как в тексте сводки выше), а не
			// отдельный счетчик HTTP 2xx -- такого счетчика сервер не
			// возвращает отдельно от общего результата пакета.
			Журнал.Вставить(
				"ПоследнееПринято",
				Итоги.Пациенты + Итоги.Врачи + Итоги.Записи + Итоги.Расходы);
			Журнал.Вставить("ПоследнееОтклонено", Итоги.ОперационныхОтклонено);
			Если Итоги.ОперационныхОтклонено > 0 Тогда
				Журнал.Вставить("ПоследнийСтатус", "partial");
				Журнал.Вставить("ПоследнееСообщение", ПредставлениеИтоговСинхронизации(Итоги));
				Журнал.Вставить("ПоследняяОшибка", Неопределено);
				// Намеренно НЕ трогаем ПоследнийУспешныйКонец: следующий
				// прогон должен повторить то же окно целиком.
				РвЗаписатьЖурналПочасовойСинхронизации(
					"Частично выполнено: " + Журнал.ПоследнееСообщение, Ложь);
			Иначе
				Журнал.Вставить("ПоследнийСтатус", "succeeded");
				Журнал.Вставить("ПоследнийУспешныйКонец", КонецПериода);
				Журнал.Вставить("ПоследнийУспехВ", ТекущаяДата());
				Журнал.Вставить("ПоследнееСообщение", ПредставлениеИтоговСинхронизации(Итоги));
				Журнал.Вставить("ПоследняяОшибка", Неопределено);
				РвЗаписатьЖурналПочасовойСинхронизации(Журнал.ПоследнееСообщение, Истина);
			КонецЕсли;
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Журнал.Вставить("ПоследнийСтатус", "failed");
			Журнал.Вставить("ПоследняяОшибка", ТекстОшибки);
			Журнал.Вставить("ПоследняяОшибкаВ", ТекущаяДата());
			// Watermark не трогаем -- следующий прогон повторит то же окно.
			РвЗаписатьЖурналПочасовойСинхронизации("Синхронизация не выполнена: " + ТекстОшибки, Ложь);
		КонецПопытки;

		Журнал.Вставить("ПоследнееЗавершеноВ", ТекущаяДата());
		Журнал.Вставить("ЗахваченоДо", Неопределено);
		ХранилищеСистемныхНастроек.Сохранить("Revora/ПочасоваяСинхронизация",, Журнал);
	Исключение
		// Последний рубеж: даже сбой самого механизма блокировки/журналирования
		// не должен уронить регламентное задание непредсказуемым образом.
		Попытка
			РвЗаписатьЖурналПочасовойСинхронизации(
				"Непредвиденная ошибка регламентной синхронизации: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ложь);
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

Процедура РвЗаписатьЖурналПочасовойСинхронизации(Сообщение, Успех)
	Если Успех Тогда
		ЗаписьЖурналаРегистрации("Revora.ПочасоваяСинхронизация",
			УровеньЖурналаРегистрации.Информация,,, Сообщение);
	Иначе
		ЗаписьЖурналаРегистрации("Revora.ПочасоваяСинхронизация",
			УровеньЖурналаРегистрации.Предупреждение,,, Сообщение);
	КонецЕсли;
КонецПроцедуры

// Читает журнал последнего автоматического запуска для отображения в форме
// настроек. Возвращает Неопределено, если регламентная синхронизация еще
// ни разу не запускалась.
Функция ПолучитьЖурналПочасовойСинхронизации() Экспорт
	Возврат ХранилищеСистемныхНастроек.Загрузить("Revora/ПочасоваяСинхронизация");
КонецФункции


// ИСПРАВЛЕНО (ревизия v18): раньше возвращалось только суммарное количество
// отправленных операционных записей одним числом -- ни разбивки по видам
// сущностей (пациенты/врачи/записи/расходы), ни отклоненных сервером строк
// не было видно нигде, кроме журнала регистрации. Теперь возвращается
// подробная Структура: наблюдаемость синхронизации (см.
// СинхронизироватьПериод и форму настроек) может честно показать, что
// именно ушло и что именно сервер отклонил, вместо одной невыразительной
// суммы.
Функция СинхронизироватьОперационныеДанные(НачалоПериода, КонецПериода, АдресAPI, Токен) Экспорт
	ИтогПациенты = ОтправитьПациентовОперационногоКонтура(АдресAPI, Токен);
	ИтогВрачи = ОтправитьВрачейОперационногоКонтура(АдресAPI, Токен);
	ИтогЗаписи = ОтправитьЗаписиОперационногоКонтура(
		НачалоПериода, КонецПериода, АдресAPI, Токен);
	ИтогРасходы = ОтправитьЗатратыОперационногоКонтура(
		НачалоПериода, КонецПериода, АдресAPI, Токен);

	// ИСПРАВЛЕНО (ревизия v18.1): раньше отклоненные записи считались, но
	// причина отклонения нигде не сохранялась -- сервер API уже возвращает
	// короткие, безопасные причины (см. ОтправитьПакетОперационныхДанных
	// ниже; никогда не содержат телефон, токен или содержимое записи
	// целиком). Собираем их из всех четырех потоков в один список,
	// ограниченный ДобавитьПричины (не более 20 записей на весь прогон) --
	// наблюдаемость синхронизации без риска раздуть журнал.
	ПричиныОтклонения = Новый Массив;
	ДобавитьПричины(ПричиныОтклонения, ИтогПациенты.ПричиныОтклонения);
	ДобавитьПричины(ПричиныОтклонения, ИтогВрачи.ПричиныОтклонения);
	ДобавитьПричины(ПричиныОтклонения, ИтогЗаписи.ПричиныОтклонения);
	ДобавитьПричины(ПричиныОтклонения, ИтогРасходы.ПричиныОтклонения);

	Результат = Новый Структура;
	Результат.Вставить("Пациенты", ИтогПациенты.Отправлено);
	Результат.Вставить("Врачи", ИтогВрачи.Отправлено);
	Результат.Вставить("Направлений", ИтогВрачи.РазныхСпециализаций);
	Результат.Вставить("Записи", ИтогЗаписи.Отправлено);
	Результат.Вставить("Расходы", ИтогРасходы.Отправлено);
	Результат.Вставить("ВсегоОтправлено",
		ИтогПациенты.Отправлено + ИтогВрачи.Отправлено + ИтогЗаписи.Отправлено + ИтогРасходы.Отправлено);
	Результат.Вставить("ВсегоОтклонено",
		ИтогПациенты.Отклонено + ИтогВрачи.Отклонено + ИтогЗаписи.Отклонено + ИтогРасходы.Отклонено);
	Результат.Вставить("ПричиныОтклонения", ПричиныОтклонения);
	Возврат Результат;
КонецФункции

// Ограничивает общее число сохраненных причин отклонения за весь прогон
// синхронизации (не за один пакет) -- см. вызовы выше. Каждая отдельная
// причина уже ограничена по длине в ОтправитьПакетОперационныхДанных.
Процедура ДобавитьПричины(Накопитель, Источник)
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Источник Цикл
		Если Накопитель.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Накопитель.Добавить(Элемент);
	КонецЦикла;
КонецПроцедуры


Функция ОтправитьПациентовОперационногоКонтура(АдресAPI, Токен)
	ТекстЗапроса =
	"ВЫБРАТЬ
	| Пациенты.Ссылка КАК Пациент,
	| Пациенты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	| Пациенты.ИсточникИнформации КАК ИсточникИнформации,
	| Пациенты.Телефон КАК ТелефонКарточки,
	| Пациенты.ПометкаУдаления КАК ПометкаУдаления,
	| Сведения.Телефон КАК ТелефонСписка,
	| Сведения.ДатаПервогоПриема КАК ДатаПервогоПриема,
	| Сведения.ДатаПоследнегоПриема КАК ДатаПоследнегоПриема,
	| Сведения.КоличествоПриемов КАК КоличествоПриемов
	|ИЗ
	| Справочник.Контрагенты КАК Пациенты
	|  ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтрагентыСведенияДляСписка КАК Сведения
	|  ПО Сведения.Контрагент = Пациенты.Ссылка
	|ГДЕ
	| НЕ Пациенты.ЭтоГруппа";
	ЗапросПациентов = Новый Запрос(ТекстЗапроса);
	Выборка = ЗапросПациентов.Выполнить().Выбрать();
	Пакет = Новый Массив;
	НомерПакета = 1;
	Количество = 0;
	Отклонено = 0;
	ПричиныОтклонения = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ВнешнийID = КлючСсылки(Выборка.Пациент);
		Если ВнешнийID = "empty" Тогда Продолжить; КонецЕсли;
		Данные = Новый Структура;
		Данные.Вставить("external_id", ВнешнийID);
		Данные.Вставить("full_name", ОпределитьФИОПациента(Выборка.Пациент));
		Телефон = СокрЛП(Строка(Выборка.ТелефонСписка));
		Если ПустаяСтрока(Телефон) Тогда Телефон = СокрЛП(Строка(Выборка.ТелефонКарточки)); КонецЕсли;
		Если ПустаяСтрока(Телефон) Тогда Телефон = ОпределитьТелефонПациента(Выборка.Пациент); КонецЕсли;
		Если Не ПустаяСтрока(Телефон) Тогда
			Хэш = ХэшТелефона(Телефон);
			Если Не ПустаяСтрока(Хэш) Тогда Данные.Вставить("phone_hash", Хэш); КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ИсточникИнформации) Тогда
			Данные.Вставить("lead_source", Строка(Выборка.ИсточникИнформации));
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаПервогоПриема) Тогда
			Данные.Вставить("first_visit_at", Формат(Выборка.ДатаПервогоПриема, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаПоследнегоПриема) Тогда
			Данные.Вставить("last_visit_at", Формат(Выборка.ДатаПоследнегоПриема, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		КонецЕсли;
		Данные.Вставить("visit_count", Число0(Выборка.КоличествоПриемов));
		Данные.Вставить("is_active", Не Выборка.ПометкаУдаления);
		ДобавитьРеквизитыФилиала(Данные, Выборка.СтруктурнаяЕдиница);
		Пакет.Добавить(НоваяОперационнаяЗапись("patient", Данные));
		Количество = Количество + 1;
		Если Пакет.Количество() >= 200 Тогда
			Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "patients", НомерПакета, Пакет, ПричиныОтклонения);
			Пакет = Новый Массив;
			НомерПакета = НомерПакета + 1;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "patients", НомерПакета, Пакет, ПричиныОтклонения);
	КонецЕсли;
	Возврат Новый Структура("Отправлено,Отклонено,ПричиныОтклонения", Количество, Отклонено, ПричиныОтклонения);
КонецФункции


Функция ОтправитьВрачейОперационногоКонтура(АдресAPI, Токен)
	ТекстЗапроса =
	"ВЫБРАТЬ
	| Специализации.Ссылка КАК Сотрудник,
	| Специализации.Специализация КАК Специализация,
	| Специализации.Основная КАК Основная
	|ИЗ
	| Справочник.Сотрудники.СпецилазацииСотрудника КАК Специализации
	|ГДЕ
	| НЕ Специализации.Ссылка.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	| Специализации.Ссылка,
	| Специализации.Основная";
	ЗапросВрачей = Новый Запрос(ТекстЗапроса);
	Выборка = ЗапросВрачей.Выполнить().Выбрать();
	Пакет = Новый Массив;
	НомерПакета = 1;
	Количество = 0;
	Отклонено = 0;
	ПричиныОтклонения = Новый Массив;
	Специализации = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("external_id", КлючСсылки(Выборка.Сотрудник));
		Данные.Вставить("full_name", Строка(Выборка.Сотрудник));
		Данные.Вставить("specialty", Строка(Выборка.Специализация));
		Если ЗначениеЗаполнено(Выборка.Специализация) Тогда
			Специализации.Вставить(КлючСсылки(Выборка.Специализация), Истина);
		КонецЕсли;
		Пакет.Добавить(НоваяОперационнаяЗапись("doctor", Данные));
		Количество = Количество + 1;
		Если Пакет.Количество() >= 200 Тогда
			Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "doctors", НомерПакета, Пакет, ПричиныОтклонения);
			Пакет = Новый Массив;
			НомерПакета = НомерПакета + 1;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "doctors", НомерПакета, Пакет, ПричиныОтклонения);
	КонецЕсли;
	Возврат Новый Структура("Отправлено,Отклонено,РазныхСпециализаций,ПричиныОтклонения", Количество, Отклонено, Специализации.Количество(), ПричиныОтклонения);
КонецФункции


Функция ОтправитьЗаписиОперационногоКонтура(НачалоПериода, КонецПериода, АдресAPI, Токен)
	ТекстЗапроса =
	"ВЫБРАТЬ
	| События.Ссылка КАК Событие,
	| События.Дата КАК ДатаНачала,
	| События.Контрагент КАК Пациент,
	| События.Врач КАК Врач,
	| События.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	| События.Статус КАК Статус,
	| События.СтатусПациента КАК СтатусПациента,
	| События.СсылкаНаПрием КАК Прием,
	| События.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	| Документ.Событие КАК События
	|ГДЕ
	| События.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Выборка = Запрос.Выполнить().Выбрать();
	Пакет = Новый Массив;
	НомерПакета = 1;
	Количество = 0;
	Отклонено = 0;
	ПричиныОтклонения = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("external_id", КлючСсылки(Выборка.Событие));
		Данные.Вставить("starts_at", Формат(Выборка.ДатаНачала, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Если ЗначениеЗаполнено(Выборка.Пациент) Тогда
			Данные.Вставить("patient_external_id", КлючСсылки(Выборка.Пациент));
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Врач) Тогда
			Данные.Вставить("doctor_external_id", КлючСсылки(Выборка.Врач));
		КонецЕсли;
		ЕстьПрием = ЗначениеЗаполнено(Выборка.Прием);
		Данные.Вставить("has_reception", ЕстьПрием);
		Данные.Вставить("is_primary", СтрНайти(НРег(Строка(Выборка.СтатусПациента)), "первич") > 0);
		Данные.Вставить("status", НормализоватьСтатусЗаписи(
			Выборка.Статус, Выборка.ПометкаУдаления, ЕстьПрием));
		ДобавитьРеквизитыФилиала(Данные, Выборка.СтруктурнаяЕдиница);
		Пакет.Добавить(НоваяОперационнаяЗапись("appointment", Данные));
		Количество = Количество + 1;
		Если Пакет.Количество() >= 200 Тогда
			Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "appointments", НомерПакета, Пакет, ПричиныОтклонения);
			Пакет = Новый Массив;
			НомерПакета = НомерПакета + 1;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "appointments", НомерПакета, Пакет, ПричиныОтклонения);
	КонецЕсли;
	Возврат Новый Структура("Отправлено,Отклонено,ПричиныОтклонения", Количество, Отклонено, ПричиныОтклонения);
КонецФункции


Функция ОтправитьЗатратыОперационногоКонтура(НачалоПериода, КонецПериода, АдресAPI, Токен)
	// Документ «Затраты» отражает признанный расход и содержит прямую связь
	// со статьей и филиалом. Не подменяем его всеми банковскими списаниями:
	// переводы между счетами и выдача зарплаты не являются новым расходом P&L.
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Затраты.Ссылка КАК Документ,
	|	Затраты.Дата КАК Дата,
	|	Затраты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Затраты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Затраты.СуммаДокумента КАК Сумма,
	|	Затраты.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.Затраты КАК Затраты
	|ГДЕ
	|	Затраты.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Затраты.ПометкаУдаления
	|	И Затраты.Проведен";
	ЗапросЗатрат = Новый Запрос(ТекстЗапроса);
	ЗапросЗатрат.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросЗатрат.УстановитьПараметр("КонецПериода", КонецПериода);
	Выборка = ЗапросЗатрат.Выполнить().Выбрать();
	Пакет = Новый Массив;
	НомерПакета = 1;
	Количество = 0;
	Отклонено = 0;
	ПричиныОтклонения = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ВнешнийID = КлючСсылки(Выборка.Документ);
		Если ВнешнийID = "empty" Тогда Продолжить; КонецЕсли;
		Сумма = Число0(Выборка.Сумма);
		Если Сумма = 0 Тогда Продолжить; КонецЕсли;
		Данные = Новый Структура;
		Данные.Вставить("external_id", ВнешнийID);
		Данные.Вставить("occurred_on", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd"));
		Данные.Вставить("amount", Сумма);
		// Документ формируется на основании списания денежных средств, поэтому
		// для него сумма оплаты равна признанной сумме документа.
		Данные.Вставить("paid_amount", Сумма);
		Данные.Вставить("currency", "KZT");
		Если ЗначениеЗаполнено(Выборка.СтатьяЗатрат) Тогда
			Данные.Вставить("category_name", Строка(Выборка.СтатьяЗатрат));
		КонецЕсли;
		Если Не ПустаяСтрока(СокрЛП(Строка(Выборка.Комментарий))) Тогда
			Данные.Вставить("description", Строка(Выборка.Комментарий));
		КонецЕсли;
		ДобавитьРеквизитыФилиала(Данные, Выборка.СтруктурнаяЕдиница);
		Пакет.Добавить(НоваяОперационнаяЗапись("expense_fact", Данные));
		Количество = Количество + 1;
		Если Пакет.Количество() >= 200 Тогда
			Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "expenses", НомерПакета, Пакет, ПричиныОтклонения);
			Пакет = Новый Массив;
			НомерПакета = НомерПакета + 1;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Отклонено = Отклонено + ОтправитьПакетОперационныхДанных(АдресAPI, Токен, "expenses", НомерПакета, Пакет, ПричиныОтклонения);
	КонецЕсли;
	Возврат Новый Структура("Отправлено,Отклонено,ПричиныОтклонения", Количество, Отклонено, ПричиныОтклонения);
КонецФункции


Функция НормализоватьСтатусЗаписи(Статус1С, ПометкаУдаления, ЕстьПрием)
	Если ПометкаУдаления Тогда Возврат "deleted"; КонецЕсли;
	Если ЕстьПрием Тогда Возврат "completed"; КонецЕсли;
	ТекстСтатуса = НРег(Строка(Статус1С));
	Если СтрНайти(ТекстСтатуса, "отмен") > 0 Тогда Возврат "cancelled"; КонецЕсли;
	Если СтрНайти(ТекстСтатуса, "неяв") > 0 Или СтрНайти(ТекстСтатуса, "не приш") > 0 Тогда
		Возврат "no_show";
	КонецЕсли;
	Возврат "scheduled";
КонецФункции


Процедура ДобавитьРеквизитыФилиала(Данные, СтруктурнаяЕдиница)
	Если Не ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда Возврат; КонецЕсли;
	Данные.Вставить("branch_key", КлючСсылки(СтруктурнаяЕдиница));
	Данные.Вставить("branch_label", Строка(СтруктурнаяЕдиница));
КонецПроцедуры


Функция НоваяОперационнаяЗапись(ТипСущности, Данные)
	Возврат Новый Структура("target_entity,data", ТипСущности, Данные);
КонецФункции


// ИСПРАВЛЕНО (ревизия v18): раньше ЛЮБОЕ ненулевое "rejected" в ответе
// сервера (даже одна отклоненная запись из 200 -- например, дубликат или
// разовая ошибка валидации одной строки) приводило к ВызватьИсключение и
// обрывало ВСЮ дальнейшую синхронизацию (последующие пакеты и потоки
// вообще не отправлялись). Сервер API же по конструкции обрабатывает
// пакет по частям и никогда не отклоняет весь пакет целиком из-за одной
// плохой строки (см. backend: CanonicalWriteError на уровне записи, не
// транзакции) -- 1С не должен обрабатывать частичное принятие как фатальную
// ошибку. Теперь функция ловит только настоящий сбой (HTTP-код вне 2xx) и
// в остальных случаях возвращает количество отклоненных записей, разбирая
// JSON-ответ по-настоящему (а не поиском подстроки), что не ломается от
// форматирования пробелов или порядка полей в ответе.
Функция ОтправитьПакетОперационныхДанных(АдресAPI, Токен, ИмяПотока, НомерПакета, Записи, ПричиныОтклонения = Неопределено)
	Адрес = СокрЛП(АдресAPI);
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	Иначе
		ВызватьИсключение "Revora требует HTTPS";
	КонецЕсли;
	ПозицияСлэша = СтрНайти(Адрес, "/");
	Если ПозицияСлэша = 0 Тогда
		Хост = Адрес;
		БазовыйПуть = "";
	Иначе
		Хост = Лев(Адрес, ПозицияСлэша - 1);
		БазовыйПуть = Сред(Адрес, ПозицияСлэша);
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = "/" Тогда БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1); КонецЕсли;
	ИдентификаторПакета = ИмяПотока + "-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + "-" + Строка(НомерПакета);
	ТелоПакета = Новый Структура("batch_id,records", ИдентификаторПакета, Записи);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоПакета);
	Тело = ЗаписьJSON.Закрыть();
	Соединение = Новый HTTPСоединение(Хост, 443, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	HTTPЗапрос = Новый HTTPЗапрос(БазовыйПуть + "/api/v1/integrations/1c/operational-records/batch");
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Revora отклонила операционный пакет: HTTP "
			+ Строка(Ответ.КодСостояния) + ", " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Попытка
		ЧтениеОтвета = Новый ЧтениеJSON;
		ЧтениеОтвета.УстановитьСтроку(ТелоОтвета);
		РазобранныйОтвет = ПрочитатьJSON(ЧтениеОтвета);
		ЧтениеОтвета.Закрыть();
		Если ТипЗнч(РазобранныйОтвет) = Тип("Структура") И РазобранныйОтвет.Свойство("rejected") Тогда
			// ИСПРАВЛЕНО (ревизия v18.1): раньше считали только количество
			// отклоненных записей, но не сохраняли ПОЧЕМУ -- сервер API уже
			// возвращает короткие, безопасные причины в массиве errors
			// (см. backend integrations/schemas.py::OneCOperationalRecordError
			// -- index/target_entity/external_id/message; message берется из
			// str(CanonicalWriteError)[:1000] и никогда не содержит телефон,
			// токен или запись целиком). Разбираем его тоже, ограничивая
			// сколько причин берем из ОДНОГО пакета -- общий лимит на весь
			// прогон применяется выше, в ДобавитьПричины.
			Если ПричиныОтклонения <> Неопределено И РазобранныйОтвет.Свойство("errors") Тогда
				МассивОшибок = РазобранныйОтвет.errors;
				Если ТипЗнч(МассивОшибок) = Тип("Массив") Тогда
					ВзятоИзПакета = 0;
					Для Каждого ОднаОшибка Из МассивОшибок Цикл
						Если ВзятоИзПакета >= 5 Тогда
							Прервать;
						КонецЕсли;
						Если ТипЗнч(ОднаОшибка) = Тип("Структура") Тогда
							Сущность = "";
							Идентификатор = "";
							Сообщение = "";
							ОднаОшибка.Свойство("target_entity", Сущность);
							ОднаОшибка.Свойство("external_id", Идентификатор);
							ОднаОшибка.Свойство("message", Сообщение);
							ПричиныОтклонения.Добавить(
								ИмяПотока + "/" + Строка(Сущность) + " " + Строка(Идентификатор)
								+ ": " + Лев(Строка(Сообщение), 200));
							ВзятоИзПакета = ВзятоИзПакета + 1;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			Возврат Число0(РазобранныйОтвет.rejected);
		КонецЕсли;
	Исключение
		// Ответ пришел не в ожидаемом JSON-формате -- не считаем это отклонением
		// записей (HTTP-код уже проверен выше как успешный), просто не можем
		// сосчитать точное число отклоненных для наблюдаемости этого пакета.
	КонецПопытки;
	Возврат 0;
КонецФункции

// Подставляет границы периода в текст запроса штатного отчета и падает,
// если шаблон не совпал.
//
// СтрЗаменить при несовпадении молча возвращает исходный текст. Параметры
// &НачалоПериода/&КонецПериода тогда в запросе не появляются,
// УстановитьПараметр для несуществующего параметра ошибки не вызывает, а
// виртуальная таблица оборотов отрабатывает по ВСЕЙ истории. Разрез при
// этом оказывается кратно больше итога клиники, и распознать причину по
// одним лишь цифрам постфактум почти невозможно. Явная ошибка честнее
// тихо неверных данных, поэтому здесь исключение.
Функция ПодставитьПериодВЗапрос(ТекстЗапроса, Шаблон, Замена, ИмяОтчета)
	Если Найти(ТекстЗапроса, Шаблон) = 0 Тогда
		ВызватьИсключение "Подстановка периода в запрос отчета " + ИмяОтчета
			+ " не сработала: шаблон """ + Шаблон + """ не найден в тексте набора данных."
			+ " Запрос отработал бы по всей истории, а не за выбранный период.";
	КонецЕсли;
	Возврат СтрЗаменить(ТекстЗапроса, Шаблон, Замена);
КонецФункции

Функция СформироватьВыручкуПоУслугам(НачалоПериода, КонецПериода)

	// Берем запрос непосредственно из того же отчета, который сотрудники
	// формируют в 1С: «Оказанные услуги, продажи по пациентам».
	ОбъектОтчета = Отчеты.ОказанныеУслугиПоВрачу.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	ТекстЗапроса = Схема.НаборыДанных.Найти("Запрос").Запрос;
	ТекстЗапроса = ПодставитьПериодВЗапрос(ТекстЗапроса, "Обороты(, , Авто,",
		"Обороты(&НачалоПериода, &КонецПериода, Авто,", "ОказанныеУслугиПоВрачу");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	// Верхняя граница виртуальной таблицы оборотов исключающая. Передаем
	// начало следующего дня, чтобы движения в 23:59:59 последнего дня не терялись.
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	Специализации = Новый Соответствие;
	ИтогоКоличество = 0;
	ИтогоСтоимость = 0;
	ИтогоБезСкидки = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Специализация = Выборка.Номенклатура.Специализация;
		КлючСпециализации = КлючСсылки(Специализация);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Группа.Количество = Группа.Количество + Число0(Выборка.Количество);
		Группа.Сумма = Группа.Сумма + Число0(Выборка.Стоимость);
		Группа.БезСкидки = Группа.БезСкидки + Число0(Выборка.ЦенаБезСкидки);
		ИтогоКоличество = ИтогоКоличество + Число0(Выборка.Количество);
		ИтогоСтоимость = ИтогоСтоимость + Число0(Выборка.Стоимость);
		ИтогоБезСкидки = ИтогоБезСкидки + Число0(Выборка.ЦенаБезСкидки);

		СоставнойКлюч = КлючФилиала + "|" + КлючСпециализации;
		ГруппаСпециализации = ПолучитьГруппу(Специализации, СоставнойКлюч, Строка(Специализация));
		ГруппаСпециализации.Количество = ГруппаСпециализации.Количество + Число0(Выборка.Количество);
		ГруппаСпециализации.Сумма = ГруппаСпециализации.Сумма + Число0(Выборка.Стоимость);
	КонецЦикла;

	Для Каждого Элемент Из Специализации Цикл
		ЧастиКлюча = СтрРазделить(Элемент.Ключ, "|");
		КлючФилиала = ЧастиКлюча[0];
		КлючСпециализации = ЧастиКлюча[1];
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "services_count", "specialty", КлючСпециализации,
			Группа.Наименование, Группа.Количество, "count", КлючФилиала);
		ДобавитьМетрику(Метрики, "revenue_accrual", "specialty", КлючСпециализации,
			Группа.Наименование, Группа.Сумма, "KZT", КлючФилиала);
	КонецЦикла;

	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "services_count", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Количество, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "revenue_accrual", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "revenue_before_discount", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.БезСкидки, "KZT", Элемент.Ключ);
	КонецЦикла;

	// Общий итог берем из результата штатной СКД. Именно этот путь использует
	// экранный отчет 1С; прямой Запрос не воспроизводит его итог полностью.
	//
	// ИСПРАВЛЕНО (ревизия v18.3): раньше это присваивание молча ЗАМЕЩАЛО
	// сумму строк прямого запроса -- ту самую, которой уже посчитаны
	// разрезы по филиалам и специализациям выше. Итог и разрез приходили
	// из двух разных вычислений, и расхождение между ними (на реальных
	// данных клиники около 1.97 млн KZT) нигде не сохранялось: его нельзя
	// было ни увидеть, ни объяснить, ни опровергнуть. Теперь сохраняются
	// оба числа и разница между ними -- как факт, а не как догадка.
	ИтогоСтоимостьЗапрос = ИтогоСтоимость;
	ДиагностикаИтога = ДиагностикаИтогаВыручкиШтатногоОтчета(НачалоПериода, КонецПериода);
	ИтогоСтоимость = ДиагностикаИтога.Значение;

	// Начисленная выручка по врачу берется из того же регистра Продажи и за
	// тот же период, что и основной отчет.
	//
	// ИСПРАВЛЕНО (ревизия v18): раньше разрез отправлялся только если сумма
	// всех врачей ТОЧНО (до 0.01) сошлась с официальным итогом клиники --
	// на реальных данных (продажи без назначенного сотрудника, скидки,
	// округления штатного отчета) точное совпадение практически никогда не
	// достигается, поэтому разрез всегда молча пропадал: doctor_revenue_accrual
	// не приходил в Revora ни разу, и колонка "Начислено" показывала 0 даже
	// при ненулевой "Оплачено". Строки без сотрудника (КлючВрача = "empty")
	// раньше вообще выбрасывались из суммы -- теперь они идут в отдельную,
	// явно поименованную группу "Не указано" (тот же прием, что и в разрезе
	// doctor_revenue_payment ниже), вместо потери из знаменателя.
	//
	// Разрез теперь отправляется ВСЕГДА (данные важнее показной точности).
	// Расхождение с официальным итогом (если оно есть) не скрывается -- оно
	// сохраняется в summary снимка как doctor_accrual_reconciliation_diff и
	// попадает в наблюдаемость синхронизации (см. СинхронизироватьПериод).
	ДокторАкруалОшибка = Ложь;
	ДокторАкруалСтрок = 0;
	ДокторАкруалРазница = 0;
	Попытка
		ЗапросВрачей = Новый Запрос;
		ЗапросВрачей.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПродажиОбороты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
		|	ПродажиОбороты.Сотрудник КАК Врач,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		Авто,
		|		) КАК ПродажиОбороты
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.СтруктурнаяЕдиница,
		|	ПродажиОбороты.Сотрудник";
		ЗапросВрачей.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросВрачей.УстановитьПараметр("КонецПериода", КонецПериода + 1);
		ВрачиНачисление = Новый Соответствие;
		ИтогоПоВрачам = 0;
		ВыборкаВрачей = ЗапросВрачей.Выполнить().Выбрать();
		Пока ВыборкаВрачей.Следующий() Цикл
			КлючВрача = КлючСсылки(ВыборкаВрачей.Врач);
			КлючФилиала = КлючСсылки(ВыборкаВрачей.СтруктурнаяЕдиница);
			СуммаВрача = Число0(ВыборкаВрачей.Сумма);
			ИтогоПоВрачам = ИтогоПоВрачам + СуммаВрача;
			СоставнойКлюч = КлючФилиала + "|" + КлючВрача;
			Если ВрачиНачисление.Получить(СоставнойКлюч) = Неопределено Тогда
				// КлючСсылки() отдает "empty" для незаполненного сотрудника.
				// Такие строки -- это реальные продажи без врача, и они должны
				// быть названы, а не приехать с пустым именем: Revora считает их
				// отдельно (unattributed_total) и не путает с необъясненной
				// разницей.
				НаименованиеВрача = ?(КлючВрача = "empty", "Не указано", Строка(ВыборкаВрачей.Врач));
				ВрачиНачисление.Вставить(СоставнойКлюч,
					Новый Структура("Ключ,Наименование,КлючФилиала,Сумма",
						КлючВрача, НаименованиеВрача, КлючФилиала, 0));
			КонецЕсли;
			ГруппаВрача = ВрачиНачисление.Получить(СоставнойКлюч);
			ГруппаВрача.Сумма = ГруппаВрача.Сумма + СуммаВрача;
		КонецЦикла;
		РазницаИтогов = ИтогоПоВрачам - ИтогоСтоимость;
		Если РазницаИтогов < 0 Тогда
			РазницаИтогов = -РазницаИтогов;
		КонецЕсли;
		ДокторАкруалРазница = РазницаИтогов;
		Для Каждого Элемент Из ВрачиНачисление Цикл
			ГруппаВрача = Элемент.Значение;
			ДобавитьМетрику(Метрики, "doctor_revenue_accrual", "doctor",
				ГруппаВрача.Ключ, ГруппаВрача.Наименование, ГруппаВрача.Сумма,
				"KZT", ГруппаВрача.КлючФилиала);
			ДокторАкруалСтрок = ДокторАкруалСтрок + 1;
		КонецЦикла;
	Исключение
		// Если конкретная версия 1С изменила структуру регистра, основной
		// контрольный отчет продолжает работать, а разрез начислений по
		// врачам просто не отправляется в этом снимке -- фиксируем это явно,
		// а не молчим, чтобы наблюдаемость синхронизации не выглядела как
		// "ноль строк -- всё в порядке".
		ДокторАкруалОшибка = Истина;
	КонецПопытки;
	ДобавитьМетрику(Метрики, "services_count", "clinic", "clinic", "Вся клиника", ИтогоКоличество, "count");
	ДобавитьМетрику(Метрики, "revenue_accrual", "clinic", "clinic", "Вся клиника", ИтогоСтоимость, "KZT");
	ДобавитьМетрику(Метрики, "revenue_before_discount", "clinic", "clinic", "Вся клиника", ИтогоБезСкидки, "KZT");
	Снимок = НовыйСнимок("service_revenue", НачалоПериода, КонецПериода, Метрики);
	Снимок.summary.Вставить("doctor_accrual_rows", ДокторАкруалСтрок);
	Снимок.summary.Вставить("doctor_accrual_query_failed", ДокторАкруалОшибка);
	Снимок.summary.Вставить("doctor_accrual_reconciliation_diff", ДокторАкруалРазница);
	// Сверка итога клиники с суммой строк прямого запроса. Ни одно из
	// этих чисел не подгоняется под другое -- разница отправляется как
	// есть, чтобы Revora показала ее руководителю, а не спрятала.
	Снимок.summary.Вставить("clinic_total_source", "standard_report_total_row");
	Снимок.summary.Вставить("clinic_total_report", ИтогоСтоимость);
	Снимок.summary.Вставить("clinic_total_query", ИтогоСтоимостьЗапрос);
	Снимок.summary.Вставить("clinic_total_difference", ИтогоСтоимость - ИтогоСтоимостьЗапрос);
	// Диагностика строки ИТОГО: сколько в ней вообще числовых колонок,
	// какую взяли и какие там числа. Если колонок больше двух, значит
	// предположение "первое -- количество, второе -- стоимость" неверно
	// для этой конфигурации, и расхождение объясняется именно этим.
	Снимок.summary.Вставить("total_row_numeric_columns", ДиагностикаИтога.ЧисловыхКолонок);
	Снимок.summary.Вставить("total_row_column_taken", ДиагностикаИтога.ВзятаКолонка);
	Снимок.summary.Вставить("total_row_numbers", ДиагностикаИтога.ЧислаИтога);
	Возврат Снимок;

КонецФункции

Функция СформироватьФактическиеПоступления(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредстваОбороты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ДенежныеСредстваОбороты.БанковскийСчетКасса КАК БанковскийСчетКасса,
	|	ДенежныеСредстваОбороты.ТипДенежныхСредств КАК ТипДенежныхСредств,
	|	СУММА(ДенежныеСредстваОбороты.СуммаОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		Авто,
	|		ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ПлатежнаяКарта)
	|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)) КАК ДенежныеСредстваОбороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.ПоступлениеДенежныхСредств
	|				ТОГДА ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ОплатаОтКлиента)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВзносНаЛицевойСчет)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.ПеремещениеДенежныхСредств
	|	И ВЫБОР
	|			КОГДА ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.СписаниеДенежныхСредств
	|				ТОГДА ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОплатыКлиенту)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратСЛицевогоСчета)
	|					ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОшибочнойОплатыКлиенту)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредстваОбороты.СтруктурнаяЕдиница,
	|	ДенежныеСредстваОбороты.БанковскийСчетКасса,
	|	ДенежныеСредстваОбороты.ТипДенежныхСредств";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	СпособыОплаты = Новый Соответствие;
	ФилиалыСпособов = Новый Соответствие;
	СчетаКассы = Новый Соответствие;
	ФилиалыСчетов = Новый Соответствие;
	Итого = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаСтроки = Число0(Выборка.Сумма);
		Итого = Итого + СуммаСтроки;
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Если КлючФилиала = "empty" Тогда Продолжить; КонецЕсли;
		ДобавитьКГруппе(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница), СуммаСтроки);

		КлючСпособа = КлючФилиала + "|" + КлючСсылки(Выборка.ТипДенежныхСредств);
		ДобавитьКГруппе(СпособыОплаты, КлючСпособа, Строка(Выборка.ТипДенежныхСредств), СуммаСтроки);
		ФилиалыСпособов.Вставить(КлючСпособа, КлючФилиала);

		КлючСчета = КлючФилиала + "|" + КлючСсылки(Выборка.БанковскийСчетКасса);
		ДобавитьКГруппе(СчетаКассы, КлючСчета, Строка(Выборка.БанковскийСчетКасса), СуммаСтроки);
		ФилиалыСчетов.Вставить(КлючСчета, КлючФилиала);
	КонецЦикла;

	ИтогоОтчета = ПолучитьИтогОплатыИзШтатногоОтчета(НачалоПериода, КонецПериода);
	РазницаИтогов = Итого - ИтогоОтчета;
	Если РазницаИтогов < 0 Тогда РазницаИтогов = -РазницаИтогов; КонецЕсли;
	РазрезыСогласованы = РазницаИтогов < 0.01;
	// ИСПРАВЛЕНО (ревизия v18): раньше разрезы (branch/payment_method/
	// cash_account) отправлялись только при точном (до 0.01) совпадении с
	// штатным отчетом -- на реальных данных точное совпадение редкость
	// (округления, банковские комиссии, копеечные расхождения), и разрезы
	// молча пропадали каждый раз ("разрезы оплат не отправлены" в 1С,
	// даже когда данные были). Теперь разрезы отправляются всегда;
	// расхождение с официальным итогом сохраняется в summary снимка
	// (breakdowns_reconciled/breakdowns_reconciliation_diff) для честной
	// наблюдаемости синхронизации, а не для того, чтобы прятать данные.
	Для Каждого Элемент Из Филиалы Цикл
		ДобавитьМетрику(Метрики, "revenue_payment", "branch", Элемент.Ключ,
			Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", Элемент.Ключ);
	КонецЦикла;
	Для Каждого Элемент Из СпособыОплаты Цикл
		ДобавитьМетрику(Метрики, "cash_inflow", "payment_method", Элемент.Ключ,
			Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", ФилиалыСпособов.Получить(Элемент.Ключ));
	КонецЦикла;
	Для Каждого Элемент Из СчетаКассы Цикл
		ДобавитьМетрику(Метрики, "cash_inflow", "cash_account", Элемент.Ключ,
			Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", ФилиалыСчетов.Получить(Элемент.Ключ));
	КонецЦикла;
	КоличествоРазрезовОплаты = Филиалы.Количество() + СпособыОплаты.Количество() + СчетаКассы.Количество();
	Итого = ИтогоОтчета;
	ДобавитьМетрику(Метрики, "revenue_payment", "clinic", "clinic", "Вся клиника", Итого, "KZT");
	ДобавитьМетрику(Метрики, "cash_inflow", "clinic", "clinic", "Вся клиника", Итого, "KZT");

	// Task 2: refunds as their own line item. revenue_payment/cash_inflow
	// above already net refunds out of the receipt totals (correct for
	// "cash actually received") -- this is a SEPARATE, additive query so a
	// mistake here can never corrupt the already-reconciled receipt figures
	// above. Best-effort and isolated: if this configuration's refund
	// operation types don't match, the metric is simply not sent (never a
	// guessed number) rather than breaking the whole snapshot.
	Попытка
		ЗапросВозвратов = Новый Запрос;
		ЗапросВозвратов.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ДенежныеСредстваОбороты.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Обороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		Авто,
		|		ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
		|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ПлатежнаяКарта)
		|			ИЛИ ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)) КАК ДенежныеСредстваОбороты
		|ГДЕ
		|	ДенежныеСредстваОбороты.Регистратор ССЫЛКА Документ.СписаниеДенежныхСредств
		|	И (ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОплатыКлиенту)
		|		ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратСЛицевогоСчета)
		|		ИЛИ ДенежныеСредстваОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.ВозвратОшибочнойОплатыКлиенту))";
		ЗапросВозвратов.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросВозвратов.УстановитьПараметр("КонецПериода", КонецПериода);
		ВыборкаВозвратов = ЗапросВозвратов.Выполнить().Выбрать();
		Если ВыборкаВозвратов.Следующий() Тогда
			// Sign convention for write-off turnover isn't guaranteed across
			// configurations -- take the magnitude, since "refunds" is only
			// ever meaningful as a positive amount returned to a patient.
			ИтогоВозвратов = Число0(ВыборкаВозвратов.Сумма);
			Если ИтогоВозвратов < 0 Тогда
				ИтогоВозвратов = -ИтогоВозвратов;
			КонецЕсли;
			ДобавитьМетрику(Метрики, "refunds", "clinic", "clinic", "Вся клиника", ИтогоВозвратов, "KZT");
		КонецЕсли;
	Исключение
		// Configuration-specific enum/document mismatch -- skip refunds for
		// this sync rather than sending a guessed or broken figure.
	КонецПопытки;

	Снимок = НовыйСнимок("cash_receipts", НачалоПериода, КонецПериода, Метрики);
	Снимок.summary.Вставить("breakdowns_reconciled", РазрезыСогласованы);
	Снимок.summary.Вставить("breakdowns_reconciliation_diff", РазницаИтогов);
	Снимок.summary.Вставить("breakdowns_sent", КоличествоРазрезовОплаты);
	Возврат Снимок;

КонецФункции

Функция СформироватьВыручкуПоВрачам(НачалоПериода, КонецПериода)

	ОбъектОтчета = Отчеты.АнализОплатПоВрачам.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НаборДанных = Схема.НаборыДанных.Найти("НаборДанных1");
	ТекстЗапроса = НаборДанных.Запрос;
	ТекстЗапроса = ПодставитьПериодВЗапрос(ТекстЗапроса,
		"ОстаткиИОбороты(, , Авто, ,", "ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Авто, ,",
		"АнализОплатПоВрачам");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Врачи = Новый Соответствие;
	Филиалы = Новый Соответствие;
	Итого = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		КлючВрача = КлючСсылки(Выборка.Врач);
		Сумма = Число0(Выборка.Всего);
		Итого = Итого + Сумма;
		ДобавитьКГруппе(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница), Сумма);
		СоставнойКлюч = КлючФилиала + "|" + КлючВрача;
		Если Врачи.Получить(СоставнойКлюч) = Неопределено Тогда
			Врачи.Вставить(СоставнойКлюч, Новый Структура("Ключ,Наименование,КлючФилиала,Сумма",
				КлючВрача, Строка(Выборка.Врач), КлючФилиала, 0));
		КонецЕсли;
		ГруппаВрача = Врачи.Получить(СоставнойКлюч);
		ГруппаВрача.Сумма = ГруппаВрача.Сумма + Сумма;
	КонецЦикла;

	Для Каждого Элемент Из Филиалы Цикл
		ДобавитьМетрику(Метрики, "doctor_revenue_payment", "branch", Элемент.Ключ,
			Элемент.Значение.Наименование, Элемент.Значение.Сумма, "KZT", Элемент.Ключ);
	КонецЦикла;
	Для Каждого Элемент Из Врачи Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "doctor_revenue_payment", "doctor", Группа.Ключ,
			Группа.Наименование, Группа.Сумма, "KZT", Группа.КлючФилиала);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "doctor_revenue_payment", "clinic", "clinic", "Вся клиника", Итого, "KZT");
	Возврат НовыйСнимок("doctor_revenue", НачалоПериода, КонецПериода, Метрики);

