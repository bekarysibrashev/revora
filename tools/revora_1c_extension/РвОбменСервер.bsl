Функция СформироватьПоступления(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Поступление.Ссылка КАК Документ,
	|	Поступление.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Поступление.СуммаДокумента КАК Сумма,
	|	Поступление.СуммаОплачено КАК Оплачено
	|ИЗ
	|	Документ.Поступление КАК Поступление
	|ГДЕ
	|	Поступление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Поступление.ПометкаУдаления
	|	И Поступление.Проведен";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	ИтогоВсе = 0;
	ИтогоОплаченоВсе = 0;
	ИтогоСАН = 0;
	ИтогоОплаченоСАН = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сумма = Число0(Выборка.Сумма);
		Оплачено = Число0(Выборка.Оплачено);
		ИтогоВсе = ИтогоВсе + Сумма;
		ИтогоОплаченоВсе = ИтогоОплаченоВсе + Оплачено;
		Наименование = Строка(Выборка.СтруктурнаяЕдиница);
		Если СтрНачинаетсяС(ВРег(СокрЛП(Наименование)), "SAN (") Тогда
			КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
			Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Наименование);
			Группа.Сумма = Группа.Сумма + Сумма;
			Группа.Выплачено = Группа.Выплачено + Оплачено;
			ИтогоСАН = ИтогоСАН + Сумма;
			ИтогоОплаченоСАН = ИтогоОплаченоСАН + Оплачено;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "purchases_accrual", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "purchases_paid", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.Выплачено, "KZT", Элемент.Ключ);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "purchases_accrual_all_entities", "clinic", "clinic", "Все юрлица", ИтогоВсе, "KZT");
	ДобавитьМетрику(Метрики, "purchases_paid_all_entities", "clinic", "clinic", "Все юрлица", ИтогоОплаченоВсе, "KZT");
	ДобавитьМетрику(Метрики, "purchases_accrual", "clinic", "clinic", "SAN Dental", ИтогоСАН, "KZT");
	ДобавитьМетрику(Метрики, "purchases_paid", "clinic", "clinic", "SAN Dental", ИтогоОплаченоСАН, "KZT");
	Возврат НовыйСнимок("purchases", НачалоПериода, КонецПериода, Метрики);

