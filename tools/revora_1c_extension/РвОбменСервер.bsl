Функция СформироватьПациентов(НачалоПериода, КонецПериода)

	ОбъектОтчета = Отчеты.ПациентыПосетившиеКлиникуЗаПериод.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	ТекстЗапроса = Схема.НаборыДанных.Найти("НаборДанных1").Запрос;
	ТекстЗапроса = ПодставитьПериодВЗапрос(ТекстЗапроса, "Обороты(, , Авто,",
		"Обороты(&НачалоПериода, &КонецПериода, Авто,", "ПациентыПосетившиеКлиникуЗаПериод");
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);
	Филиалы = Новый Соответствие;
	Пациенты = Новый Соответствие;
	ПациентыКлиники = Новый Соответствие;
	ПервичныеПациентыКлиники = Новый Соответствие;
	Метрики = Новый Массив;
	ИтогоПервичных = 0;
	ИтогоОказано = 0;
	ИтогоОплачено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Группа.Количество = Группа.Количество + Число0(Выборка.КоличествоПосещений);
		Группа.Первичных = Группа.Первичных + Число0(Выборка.Первичный);
		ОбщийКлючПациента = ОбезличенныйКлючПациента(Выборка.Контрагент);
		Если Не ПустаяСтрока(ОбщийКлючПациента) Тогда
			КлючПациента = КлючФилиала + "|" + ОбщийКлючПациента;
			Если Пациенты.Получить(КлючПациента) = Неопределено Тогда
				Пациенты.Вставить(КлючПациента,
					Новый Структура("КлючПациента,КлючФилиала,Первичный,Ссылка",
						ОбщийКлючПациента, КлючФилиала, Число0(Выборка.Первичный) > 0, Выборка.Контрагент));
				Группа.Пациентов = Группа.Пациентов + 1;
			ИначеЕсли Число0(Выборка.Первичный) > 0 Тогда
				ДанныеПациента = Пациенты.Получить(КлючПациента);
				ДанныеПациента.Первичный = Истина;
			КонецЕсли;
			ПациентыКлиники.Вставить(ОбщийКлючПациента, Истина);
			Если Число0(Выборка.Первичный) > 0 Тогда
				ПервичныеПациентыКлиники.Вставить(ОбщийКлючПациента, Истина);
			КонецЕсли;
		КонецЕсли;
		ИтогоПервичных = ИтогоПервичных + Число0(Выборка.Первичный);
		ИтогоОказано = ИтогоОказано + Число0(Выборка.Оказано);
		ИтогоОплачено = ИтогоОплачено + Число0(Выборка.Оплачено);
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "patients_total", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Пациентов, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "patients_primary", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Первичных, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "patient_visits", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Количество, "count", Элемент.Ключ);
	КонецЦикла;
	// Стабильные GUID без ФИО позволяют COUNT DISTINCT на произвольном диапазоне.
	Для Каждого Элемент Из Пациенты Цикл
		ДанныеПациента = Элемент.Значение;
		ДобавитьМетрику(Метрики, "patient_seen", "patient", ДанныеПациента.КлючПациента,
			"Обезличенный пациент", 1, "count", ДанныеПациента.КлючФилиала);
		Если ДанныеПациента.Первичный Тогда
			ДобавитьМетрику(Метрики, "patient_primary_seen", "patient", ДанныеПациента.КлючПациента,
				"Обезличенный пациент", 1, "count", ДанныеПациента.КлючФилиала);
		КонецЕсли;
		// Task 1: полная идентичность пациента (ФИО/phone_hash/визиты/статус)
		// для сопоставления входящих звонков и WhatsApp-сообщений с 1С.
		// В отличие от patient_seen выше, dimension_label здесь -- реальное
		// ФИО: политика конфиденциальности разрешает хранить его внутри
		// Revora, но телефон по-прежнему уходит только в виде phone_hash.
		ФИОПациента = ОпределитьФИОПациента(ДанныеПациента.Ссылка);
		ДеталиПациента = ПостроитьДеталиИдентичностиПациента(ДанныеПациента.Ссылка, ФИОПациента);
		ДобавитьМетрику(Метрики, "patient_phone_identity", "patient", ДанныеПациента.КлючПациента,
			ФИОПациента, 1, "count", ДанныеПациента.КлючФилиала, ДеталиПациента);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "patients_total", "clinic", "clinic", "Вся клиника",
		ПациентыКлиники.Количество(), "count");
	ДобавитьМетрику(Метрики, "patients_primary", "clinic", "clinic", "Вся клиника",
		ПервичныеПациентыКлиники.Количество(), "count");
	ДобавитьМетрику(Метрики, "patient_report_revenue", "clinic", "clinic", "Вся клиника", ИтогоОказано, "KZT");
	ДобавитьМетрику(Метрики, "patient_report_paid", "clinic", "clinic", "Вся клиника", ИтогоОплачено, "KZT");
	Возврат НовыйСнимок("patients", НачалоПериода, КонецПериода, Метрики);

КонецФункции

Функция СформироватьЗаписи(НачалоПериода, КонецПериода)

	ОбъектОтчета = Отчеты.СтатистикаПредварительнойЗаписи.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Запрос = Новый Запрос(Схема.НаборыДанных.Найти("НаборДанных1").Запрос);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("МеткаПациента", Справочники.Метки.ПустаяСсылка());
	Запрос.УстановитьПараметр("МеткаПредварительнойЗаписи", Справочники.Метки.ПустаяСсылка());
	Филиалы = Новый Соответствие;
	Метрики = Новый Массив;
	ИтогоЗаписей = 0;
	ИтогоПервичных = 0;
	ИтогоПриемов = 0;
	ИтогоСумма = 0;
	ИтогоОплачено = 0;
	ИтогоОтмен = 0;
	ИтогоНеявок = 0;
	ИтогоПереносов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Количество = Число0(Выборка.Количество);
		Первичных = Число0(Выборка.ЭтоПервичнаяЗапись);
		Приемов = Число0(Выборка.КоличествоПриемов);
		Сумма = Число0(Выборка.ПриемСумма);
		Оплачено = Число0(Выборка.ПриемОплачено);
		Группа.Количество = Группа.Количество + Количество;
		Группа.Первичных = Группа.Первичных + Первичных;
		Группа.Приемов = Группа.Приемов + Приемов;
		ИтогоЗаписей = ИтогоЗаписей + Количество;
		ИтогоПервичных = ИтогоПервичных + Первичных;
		ИтогоПриемов = ИтогоПриемов + Приемов;
		ИтогоСумма = ИтогоСумма + Сумма;
		ИтогоОплачено = ИтогоОплачено + Оплачено;
		Статус = НРег(Строка(Выборка.Статус));
		Причина = НРег(Строка(Выборка.ПричинаОтмены));
		Если СтрНайти(Статус, "отмен") > 0 Тогда ИтогоОтмен = ИтогоОтмен + 1; КонецЕсли;
		Если СтрНайти(Статус, "неяв") > 0 Или СтрНайти(Статус, "не приш") > 0
			Или СтрНайти(Причина, "неяв") > 0 Или СтрНайти(Причина, "не приш") > 0 Тогда
			ИтогоНеявок = ИтогоНеявок + 1;
		КонецЕсли;
		// Task 2: "перенос" (rescheduled) is tracked the same best-effort way
		// as cancellations/no-shows -- a free-text Статус/ПричинаОтмены
		// substring match, since this vertical solution has no dedicated
		// enum value for "rescheduled" the way it does for cancellation.
		Если СтрНайти(Статус, "перенос") > 0 Или СтрНайти(Причина, "перенос") > 0 Тогда
			ИтогоПереносов = ИтогоПереносов + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "appointments_total", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Количество, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "appointments_primary", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Первичных, "count", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "appointments_completed", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Приемов, "count", Элемент.Ключ);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "appointments_total", "clinic", "clinic", "Вся клиника", ИтогоЗаписей, "count");
	ДобавитьМетрику(Метрики, "appointments_primary", "clinic", "clinic", "Вся клиника", ИтогоПервичных, "count");
	ДобавитьМетрику(Метрики, "appointments_completed", "clinic", "clinic", "Вся клиника", ИтогоПриемов, "count");
	ДобавитьМетрику(Метрики, "appointments_cancelled", "clinic", "clinic", "Вся клиника", ИтогоОтмен, "count");
	ДобавитьМетрику(Метрики, "appointments_no_show", "clinic", "clinic", "Вся клиника", ИтогоНеявок, "count");
	ДобавитьМетрику(Метрики, "appointments_transferred", "clinic", "clinic", "Вся клиника", ИтогоПереносов, "count");
	ДобавитьМетрику(Метрики, "appointment_report_revenue", "clinic", "clinic", "Вся клиника", ИтогоСумма, "KZT");
	ДобавитьМетрику(Метрики, "appointment_report_paid", "clinic", "clinic", "Вся клиника", ИтогоОплачено, "KZT");
	Возврат НовыйСнимок("appointments", НачалоПериода, КонецПериода, Метрики);

КонецФункции

Функция НовыйСнимок(ТипОтчета, НачалоПериода, КонецПериода, Метрики)
	Снимок = Новый Структура;
	Снимок.Вставить("report_type", ТипОтчета);
	Снимок.Вставить("period_from", Формат(НачалоПериода, "ДФ=yyyy-MM-dd"));
	Снимок.Вставить("period_to", Формат(КонецПериода, "ДФ=yyyy-MM-dd"));
	Снимок.Вставить("metrics", Метрики);
	Гранулярность = ?(НачалоДня(НачалоПериода) = НачалоДня(КонецПериода), "day", "period");
	Снимок.Вставить("summary", Новый Структура("source,extension_version,granularity", "1c", ВерсияРасширения(), Гранулярность));
	Возврат Снимок;
КонецФункции

// Возвращает не только итог, но и то, из какой ячейки он взят.
//
// Строка ИТОГО штатного отчета содержит несколько числовых колонок, и
// отсюда молча берется "второе число" -- в предположении, что первое это
// количество, а второе стоимость. Если макет отчета в конкретной
// конфигурации несет еще одну числовую колонку (цена без скидки, средний
// чек, служебный код), предположение возвращает чужое число и дает
// стабильное расхождение с разрезом по врачам, которое невозможно
// объяснить самими данными. Само поведение (берем второе число) здесь
// НЕ меняется -- меняется наблюдаемость: все числа строки ИТОГО и номер
// взятой колонки уезжают в снимок, и гипотезу видно за один прогон
// синхронизации, а не после ручного разбора отчета.
Функция ДиагностикаИтогаВыручкиШтатногоОтчета(НачалоПериода, КонецПериода)
	Диагностика = Новый Структура;
	Диагностика.Вставить("Значение", 0);
	Диагностика.Вставить("Найдено", Ложь);
	Диагностика.Вставить("ЧисловыхКолонок", 0);
	Диагностика.Вставить("ВзятаКолонка", 0);
	Диагностика.Вставить("ЧислаИтога", Новый Массив);

	ОбъектОтчета = Отчеты.ОказанныеУслугиПоВрачу.Создать();
	Схема = ОбъектОтчета.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	ПараметрПериода = ОбъектОтчета.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Если ПараметрПериода = Неопределено Тогда
		ВызватьИсключение "В штатном отчете не найден параметр Период";
	КонецЕсли;
	ПараметрПериода.Значение = Новый СтандартныйПериод(НачалоПериода, КонецПериода);
	ПараметрПериода.Использование = Истина;

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		Схема, ОбъектОтчета.КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Ложь);
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ПроцессорВывода.ЗакончитьВывод();

	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		СтрокаИтого = Ложь;
		Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
			ТекстЯчейки = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);
			Если ВРег(ТекстЯчейки) = "ИТОГО" Тогда
				СтрокаИтого = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаИтого Тогда Продолжить; КонецЕсли;

		// Считаем ВСЮ строку целиком, а не выходим на втором числе: именно
		// количество числовых колонок и их значения показывают, то ли число
		// мы берем.
		Диагностика.ЧислаИтога = Новый Массив;
		НомерЧисла = 0;
		Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
			ТекстЧисла = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);
			ТекстЧисла = СтрЗаменить(ТекстЧисла, " ", "");
			ТекстЧисла = СтрЗаменить(ТекстЧисла, Символ(160), "");
			Если ПустаяСтрока(ТекстЧисла) Тогда Продолжить; КонецЕсли;
			ЭтоЧисло = Истина;
			Попытка
				ЗначениеЯчейки = Число(ТекстЧисла);
			Исключение
				ЭтоЧисло = Ложь;
			КонецПопытки;
			Если ЭтоЧисло Тогда
				НомерЧисла = НомерЧисла + 1;
				Диагностика.ЧислаИтога.Добавить(ЗначениеЯчейки);
				// В отчете первое число -- количество, второе -- стоимость.
				Если НомерЧисла = 2 Тогда
					Диагностика.Значение = ЗначениеЯчейки;
					Диагностика.Найдено = Истина;
					Диагностика.ВзятаКолонка = НомерКолонки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Диагностика.ЧисловыхКолонок = НомерЧисла;
		Если Диагностика.Найдено Тогда
			Возврат Диагностика;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не удалось получить строку Итого штатного отчета выручки";
КонецФункции

// Тонкая обертка: значение то же самое, что и раньше.
Функция ПолучитьИтогВыручкиИзШтатногоОтчета(НачалоПериода, КонецПериода)
	Возврат ДиагностикаИтогаВыручкиШтатногоОтчета(НачалоПериода, КонецПериода).Значение;
КонецФункции

Функция ПолучитьИтогОплатыИзШтатногоОтчета(НачалоПериода, КонецПериода)
	ОбъектОтчета = Отчеты.МониторРуководителяВыручка.Создать();
