	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Ложь);
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ПроцессорВывода.ЗакончитьВывод();

	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		СтрокаИтого = Ложь;
		Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
			ТекстЯчейки = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);
			Если ВРег(ТекстЯчейки) = "ИТОГО" Тогда
				СтрокаИтого = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокаИтого Тогда Продолжить; КонецЕсли;

		Для НомерКолонки = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
			ТекстЧисла = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);
			ТекстЧисла = СтрЗаменить(ТекстЧисла, " ", "");
			ТекстЧисла = СтрЗаменить(ТекстЧисла, Символ(160), "");
			Если ПустаяСтрока(ТекстЧисла) Тогда Продолжить; КонецЕсли;
			Попытка
				Возврат Число(ТекстЧисла);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	ВызватьИсключение "Не удалось получить строку Итого штатного отчета оплат";
КонецФункции

Функция ЗначениеМетрикиКлиники(Снимок, КодМетрики)
	Для Каждого Метрика Из Снимок.metrics Цикл
		Если Метрика.metric_code = КодМетрики И Метрика.dimension_type = "clinic" Тогда
			Возврат Число0(Метрика.value);
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Процедура ДобавитьМетрику(Метрики, Код, ТипИзмерения, Ключ, Наименование, Значение, Единица, КлючФилиала = Неопределено, Детали = Неопределено)
	// Детали -- необязательная Структура с дополнительными полями снимка
	// (используется patient_phone_identity для phone_hash/ФИО/дат/флага
	// активности). Если не передана, поведение полностью совпадает с
	// прежним -- details всегда была и остается пустой Структурой.
	Метрика = Новый Структура;
	Метрика.Вставить("dimension_type", ТипИзмерения);
	Метрика.Вставить("dimension_key", ?(ПустаяСтрока(Ключ), "empty", Ключ));
	Метрика.Вставить("dimension_label", ?(ПустаяСтрока(Наименование), "Не указано", Наименование));
	Метрика.Вставить("metric_code", Код);
	Метрика.Вставить("value", Число0(Значение));
	Метрика.Вставить("unit", Единица);
	Если КлючФилиала <> Неопределено Тогда Метрика.Вставить("branch_key", КлючФилиала); КонецЕсли;
	Если Детали = Неопределено Тогда
		Метрика.Вставить("details", Новый Структура);
	Иначе
		Метрика.Вставить("details", Детали);
	КонецЕсли;
	Метрики.Добавить(Метрика);
КонецПроцедуры

Функция ПолучитьГруппу(Группы, Ключ, Наименование)
	Группа = Группы.Получить(Ключ);
	Если Группа = Неопределено Тогда
		Группа = Новый Структура("Наименование,Количество,Сумма,БезСкидки,Выплачено,Первичных,Пациентов,Приемов",
			Наименование, 0, 0, 0, 0, 0, 0, 0);
		Группы.Вставить(Ключ, Группа);
	КонецЕсли;
	Возврат Группа;
КонецФункции

Процедура ДобавитьКГруппе(Группы, Ключ, Наименование, Сумма)
	Группа = ПолучитьГруппу(Группы, Ключ, Наименование);
	Группа.Сумма = Группа.Сумма + Число0(Сумма);
КонецПроцедуры

Функция КлючСсылки(Ссылка)
	Если Ссылка = Неопределено Или Ссылка = NULL Тогда Возврат "empty"; КонецЕсли;
	Попытка
		Возврат НРег(Строка(Ссылка.УникальныйИдентификатор()));
	Исключение
		Возврат НРег(Строка(Ссылка));
	КонецПопытки;
КонецФункции

Функция ОбезличенныйКлючПациента(Ссылка)
	Если Ссылка = Неопределено Или Ссылка = NULL Тогда Возврат ""; КонецЕсли;
	Попытка
		Возврат НРег(Строка(Ссылка.УникальныйИдентификатор()));
	Исключение
		// Никогда не подменяем GUID строковым представлением ссылки: оно может
		// содержать ФИО пациента. Такая строка просто не участвует в distinct-счётчике.
		Возврат "";
	КонецПопытки;
КонецФункции

// ---------------------------------------------------------------------
// Task 1: пациенты и телефоны из 1С (patient_phone_identity).
//
// Телефон нормализуется и хэшируется здесь же, в 1С -- открытый номер
// никогда не попадает в снимок, только SHA-256 phone_hash. Алгоритм
// нормализации и хэширования обязан побайтово совпадать с Revora
// (app/core/security.py: normalize_phone_e164 / phone_hash), иначе
// сопоставление входящих звонков/WhatsApp с пациентами 1С сломается
// молча. ТестХэшированияТелефонов() ниже сверяет это с контрольными
// значениями, посчитанными тем же алгоритмом на стороне Revora --
// вызовите её из консоли 1С после установки расширения и перед тем,
// как полагаться на phone_hash в проде.
//
// Реквизиты для телефона/ФИО/дат визитов найдены по имени через
// метаданные (best-effort): точный состав реквизитов у Контрагента
// (или иного справочника пациентов) в конкретной базе клиники не
// проверялся вживую -- нет доступа к Конфигуратору. Список кандидатов
// ниже нужно сверить с реальной базой через ДиагностикаПациента() и при
// необходимости расширить. Если ни один кандидат не подошёл, поле
// просто не попадает в details -- это не ошибка и не блокирует отправку
// остальных полей пациента (внешний ID, филиал, признак активности --
// он строится на стандартном ПометкаУдаления и не требует угадывания).
// ---------------------------------------------------------------------

Функция НормализоватьТелефон(Знач Телефон) Экспорт
	Если Телефон = Неопределено Или Телефон = NULL Тогда
		Возврат "";
	КонецЕсли;
	ИсходнаяСтрока = Строка(Телефон);
	Цифры = "";
	Для Позиция = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		Символ = Сред(ИсходнаяСтрока, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Цифры) = 11 И Лев(Цифры, 1) = "8" Тогда
		Цифры = "7" + Сред(Цифры, 2);
	ИначеЕсли СтрДлина(Цифры) = 10 Тогда
		Цифры = "7" + Цифры;
	КонецЕсли;
	Если СтрДлина(Цифры) < 10 Или СтрДлина(Цифры) > 15 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "+" + Цифры;
КонецФункции

Функция ДвоичныеДанныеСтрокиUTF8(Знач Строка)
	// CESU-8 без BOM побайтово совпадает с UTF-8 для ASCII (наш нормализованный
	// номер -- только "+" и цифры), но платформа не дописывает BOM, в отличие
	// от КодировкаТекста.UTF8. Записать (не ЗаписьСтроку!) -- без завершающего
	// разделителя строк, чтобы в хэш не попали лишние байты.
	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьТекста(Поток, "CESU-8");
	Запись.Записать(Строка);
	Запись.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

Функция ХэшТелефона(Знач Телефон) Экспорт
	Нормализованный = НормализоватьТелефон(Телефон);
	Если Нормализованный = "" Тогда
		Возврат "";
	КонецЕсли;
	ДвДанные = ДвоичныеДанныеСтрокиUTF8(Нормализованный);
	Хешер = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хешер.Добавить(ДвДанные);
	Возврат НРег(СтрЗаменить(Хешер.ХешСумма, " ", ""));
КонецФункции

Функция ТестХэшированияТелефонов() Экспорт
	// Контрольные значения посчитаны в Revora тем же алгоритмом:
	// app.core.security.normalize_phone_e164 + phone_hash.
	Векторы = Новый Массив;
	Векторы.Добавить(Новый Структура("Вход,ОжидаемыйХэш",
		"+7 (777) 123-45-67", "58f5a88aca120dfb78270b6726b7fb8c84c11532aba4a240eadd1692a7028ff9"));
	Векторы.Добавить(Новый Структура("Вход,ОжидаемыйХэш",
		"87012345678", "5cf2fca546400423fc2c6f57227faa6a058a191ce936762760def12e43532e76"));
	Векторы.Добавить(Новый Структура("Вход,ОжидаемыйХэш",
		"+7 701 234 56 78", "5cf2fca546400423fc2c6f57227faa6a058a191ce936762760def12e43532e76"));
	Векторы.Добавить(Новый Структура("Вход,ОжидаемыйХэш",
		"77012345678", "5cf2fca546400423fc2c6f57227faa6a058a191ce936762760def12e43532e76"));
	Векторы.Добавить(Новый Структура("Вход,ОжидаемыйХэш",
		"8 (701) 234-56-78", "5cf2fca546400423fc2c6f57227faa6a058a191ce936762760def12e43532e76"));

	Ошибки = Новый Массив;
	Для Каждого Вектор Из Векторы Цикл
		Фактический = ХэшТелефона(Вектор.Вход);
		Если Фактический <> Вектор.ОжидаемыйХэш Тогда
			Ошибки.Добавить("'" + Вектор.Вход + "': ожидали " + Вектор.ОжидаемыйХэш + ", получили '" + Фактический + "'");
		КонецЕсли;
	КонецЦикла;
	// Разные форматы одного и того же номера обязаны давать один и тот же хэш.
	Если ХэшТелефона("87012345678") <> ХэшТелефона("+7 701 234 56 78") Тогда
		Ошибки.Добавить("Разные форматы одного номера дали разные хэши");
	КонецЕсли;
	Если НормализоватьТелефон("123") <> "" Тогда
		Ошибки.Добавить("Слишком короткий номер должен нормализоваться в пустую строку");
	КонецЕсли;
	Если НормализоватьТелефон("") <> "" Тогда
		Ошибки.Добавить("Пустой номер должен нормализоваться в пустую строку");
	КонецЕсли;
	Если СтрДлина(ХэшТелефона("+77012345678")) <> 64 Тогда
		Ошибки.Добавить("Хэш SHA-256 должен состоять из 64 hex-символов");
	КонецЕсли;

	Если Ошибки.Количество() = 0 Тогда
		Возврат Новый Структура("Успех,Сообщение", Истина,
			"Самопроверка хэширования телефонов пройдена: " + Строка(Векторы.Количество()) + " контрольных значений совпали.");
	Иначе
		Возврат Новый Структура("Успех,Сообщение", Ложь,
			"ОШИБКА самопроверки хэширования телефонов: " + СтрСоединить(Ошибки, "; "));
	КонецЕсли;
КонецФункции

Функция ПациентАктивен(Знач Пациент) Экспорт
	Если Пациент = Неопределено Или Пациент = NULL Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Не Пациент.ПометкаУдаления;
	Исключение
		// ПометкаУдаления есть у любой ссылки справочника в 1С:Предприятие;
		// если по какой-то причине недоступна, честнее не блокировать пациента,
		// чем ошибочно пометить его как удалённого.
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция ЗначениеРеквизитаПоИменам(Знач Объект, Знач ИменаРеквизитов)
	// Best-effort чтение первого подходящего реквизита по списку имён-кандидатов,
	// проверяя каждое имя через метаданные перед обращением -- обращение к
	// несуществующему реквизиту объекта иначе роняет весь снимок пациентов.
	Если Объект = Неопределено Или Объект = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Метаданные = Объект.Метаданные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Имя Из ИменаРеквизитов Цикл
		Попытка
			Если Метаданные.Реквизиты.Найти(Имя) <> Неопределено Тогда
				Значение = Объект[Имя];
				Если Значение <> Неопределено И Значение <> NULL И ЗначениеЗаполнено(Значение) Тогда
					Возврат Значение;
				КонецЕсли;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ТелефонИзКонтактнойИнформации(Знач Пациент)
	// Типовой БСП-паттерн: табличная часть "КонтактнаяИнформация" со строками
	// Вид/Представление. Есть почти во всех конфигурациях на базе БСП.
	Если Пациент = Неопределено Или Пациент = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Метаданные = Пациент.Метаданные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Попытка
		ЕстьТабличнаяЧасть = Метаданные.ТабличныеЧасти.Найти("КонтактнаяИнформация") <> Неопределено;
	Исключение
		ЕстьТабличнаяЧасть = Ложь;
	КонецПопытки;
	Если Не ЕстьТабличнаяЧасть Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Для Каждого СтрокаКИ Из Пациент.КонтактнаяИнформация Цикл
			Попытка
				ВидТекст = НРег(Строка(СтрокаКИ.Вид));
			Исключение
				ВидТекст = "";
			КонецПопытки;
			Если СтрНайти(ВидТекст, "телефон") > 0 Или СтрНайти(ВидТекст, "phone") > 0 Тогда
				Попытка
					Представление = СтрокаКИ.Представление;
				Исключение
					Представление = Неопределено;
				КонецПопытки;
				Если Представление <> Неопределено И ЗначениеЗаполнено(Представление) Тогда
					Возврат Строка(Представление);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ОпределитьТелефонПациента(Знач Пациент) Экспорт
	КандидатыРеквизитов = Новый Массив;
	КандидатыРеквизитов.Добавить("ТелефонМобильный");
	КандидатыРеквизитов.Добавить("ОсновнойТелефон");
	КандидатыРеквизитов.Добавить("Телефон");
	КандидатыРеквизитов.Добавить("ТелефонОсновной");
	КандидатыРеквизитов.Добавить("КонтактныйТелефон");
	Значение = ЗначениеРеквизитаПоИменам(Пациент, КандидатыРеквизитов);
	Если Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	ИзКИ = ТелефонИзКонтактнойИнформации(Пациент);
	Если ИзКИ <> Неопределено Тогда
		Возврат ИзКИ;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОпределитьФИОПациента(Знач Пациент) Экспорт
	КандидатыРеквизитов = Новый Массив;
	КандидатыРеквизитов.Добавить("ФИО");
	КандидатыРеквизитов.Добавить("НаименованиеПолное");
	Значение = ЗначениеРеквизитаПоИменам(Пациент, КандидатыРеквизитов);
	Если Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Попытка
		Возврат Строка(Пациент);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ОпределитьДатуПервогоОбращения(Знач Пациент)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("ДатаПервогоОбращения");
	Кандидаты.Добавить("ДатаРегистрации");
	Кандидаты.Добавить("ПерваяДатаПосещения");
	Значение = ЗначениеРеквизитаПоИменам(Пациент, Кандидаты);
	Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОпределитьДатуПоследнегоПосещения(Знач Пациент)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("ДатаПоследнегоПосещения");
	Кандидаты.Добавить("ПоследнийВизит");
	Кандидаты.Добавить("ДатаПоследнегоОбращения");
	Значение = ЗначениеРеквизитаПоИменам(Пациент, Кандидаты);
	Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОпределитьКоличествоПосещенийПациента(Знач Пациент)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("КоличествоПосещений");
	Кандидаты.Добавить("ЧислоВизитов");
	Значение = ЗначениеРеквизитаПоИменам(Пациент, Кандидаты);
	Если Значение <> Неопределено Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПостроитьДеталиИдентичностиПациента(Знач Пациент, Знач ФИО = Неопределено) Экспорт
	// Собирает details ровно под контракт patient_phone_identity backend'а
	// (app/modules/reports/repository.py:_build_patient_identity_row).
	// В открытом виде телефон сюда никогда не попадает -- только phone_hash.
	Детали = Новый Структура;
	Телефон = ОпределитьТелефонПациента(Пациент);
	Если Не ПустаяСтрока(Телефон) Тогда
		Хэш = ХэшТелефона(Телефон);
		Если Не ПустаяСтрока(Хэш) Тогда
			Детали.Вставить("phone_hash", Хэш);
		КонецЕсли;
	КонецЕсли;
	Если ФИО = Неопределено Тогда
		ФИО = ОпределитьФИОПациента(Пациент);
	КонецЕсли;
	Если Не ПустаяСтрока(ФИО) Тогда
		Детали.Вставить("full_name", ФИО);
	КонецЕсли;
	ПерваяДата = ОпределитьДатуПервогоОбращения(Пациент);
	Если ПерваяДата <> Неопределено Тогда
		Детали.Вставить("first_visit_at", ПерваяДата);
	КонецЕсли;
	ПоследняяДата = ОпределитьДатуПоследнегоПосещения(Пациент);
	Если ПоследняяДата <> Неопределено Тогда
		Детали.Вставить("last_visit_at", ПоследняяДата);
	КонецЕсли;
	КоличествоПосещений = ОпределитьКоличествоПосещенийПациента(Пациент);
	Если КоличествоПосещений <> Неопределено Тогда
		Детали.Вставить("visit_count", КоличествоПосещений);
	КонецЕсли;
	Детали.Вставить("active", ПациентАктивен(Пациент));
	Детали.Вставить("updated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));
	Возврат Детали;
КонецФункции

Функция ДиагностикаПациента(Знач Пациент) Экспорт
	// Диагностический режим: вызовите из консоли 1С с конкретной ссылкой на
	// пациента (Контрагент), чтобы вживую увидеть, что именно расширение
	// нашло/не нашло по нему -- ДО того как полагаться на это в проде.
	// Пример: ДиагностикаПациента(Справочники.Контрагенты.НайтиПоКоду("00001"))
	Результат = Новый Структура;
	Результат.Вставить("СсылкаСтрокой", Строка(Пациент));
	Результат.Вставить("ВнешнийID", КлючСсылки(Пациент));
	Телефон = ОпределитьТелефонПациента(Пациент);
	Результат.Вставить("НайденТелефон", Телефон);
	Результат.Вставить("НормализованныйТелефон", ?(ПустаяСтрока(Телефон), "", НормализоватьТелефон(Телефон)));
	Результат.Вставить("ХэшТелефона", ?(ПустаяСтрока(Телефон), "", ХэшТелефона(Телефон)));
	Результат.Вставить("ФИО", ОпределитьФИОПациента(Пациент));
	Результат.Вставить("ДатаПервогоОбращения", ОпределитьДатуПервогоОбращения(Пациент));
	Результат.Вставить("ДатаПоследнегоПосещения", ОпределитьДатуПоследнегоПосещения(Пациент));
	Результат.Вставить("КоличествоПосещений", ОпределитьКоличествоПосещенийПациента(Пациент));
	Результат.Вставить("Активен", ПациентАктивен(Пациент));
	Возврат Результат;
КонецФункции
