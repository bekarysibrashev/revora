Функция СформироватьЗарплату(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Расчеты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Расчеты.Сотрудник КАК Сотрудник,
	|	СУММА(Расчеты.СуммаПриход) КАК Начислено,
	|	СУММА(Расчеты.СуммаРасход) КАК Выплачено
	|ИЗ
	|	РегистрНакопления.РасчетыСПерсоналом.ОстаткиИОбороты(
	|		, , Авто, ,
	|		МесяцНачисления >= НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ)
	|			И МесяцНачисления <= НАЧАЛОПЕРИОДА(&КонецПериода, МЕСЯЦ)) КАК Расчеты
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.СтруктурнаяЕдиница,
	|	Расчеты.Сотрудник";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	ИтогоНачислено = 0;
	ИтогоВыплачено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Начислено = Число0(Выборка.Начислено);
		Выплачено = Число0(Выборка.Выплачено);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Группа.Сумма = Группа.Сумма + Начислено;
		Группа.Выплачено = Группа.Выплачено + Выплачено;
		ИтогоНачислено = ИтогоНачислено + Начислено;
		ИтогоВыплачено = ИтогоВыплачено + Выплачено;
		ДобавитьМетрику(Метрики, "payroll_accrual", "employee", КлючСсылки(Выборка.Сотрудник),
			Строка(Выборка.Сотрудник), Начислено, "KZT", КлючФилиала);
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "payroll_accrual", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "payroll_paid", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Выплачено, "KZT", Элемент.Ключ);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "payroll_accrual", "clinic", "clinic", "Вся клиника", ИтогоНачислено, "KZT");
	ДобавитьМетрику(Метрики, "payroll_paid", "clinic", "clinic", "Вся клиника", ИтогоВыплачено, "KZT");
	ДобавитьМетрику(Метрики, "payroll_due", "clinic", "clinic", "Вся клиника", ИтогоНачислено - ИтогоВыплачено, "KZT");
	Возврат НовыйСнимок("payroll", НачалоПериода, КонецПериода, Метрики);

