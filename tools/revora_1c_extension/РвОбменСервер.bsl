Функция Число0(Значение)
	Если Значение = Неопределено Или Значение = NULL Тогда Возврат 0; КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ОтправитьПакетСнимков(АдресAPI, Токен, Снимки)
	Адрес = СокрЛП(АдресAPI);
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	Иначе
		ВызватьИсключение "Revora требует HTTPS";
	КонецЕсли;
	ПозицияСлэша = СтрНайти(Адрес, "/");
	Если ПозицияСлэша = 0 Тогда
		Хост = Адрес;
		БазовыйПуть = "";
	Иначе
		Хост = Лев(Адрес, ПозицияСлэша - 1);
		БазовыйПуть = Сред(Адрес, ПозицияСлэша);
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = "/" Тогда БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1); КонецЕсли;

	ТелоПакета = Новый Структура("snapshots", Снимки);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ТелоПакета);
	Тело = Запись.Закрыть();
	Соединение = Новый HTTPСоединение(Хост, 443, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	HTTPЗапрос = Новый HTTPЗапрос(БазовыйПуть + "/api/v1/integrations/1c/report-snapshots/batch");
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Revora отклонила пакет дневных снимков: HTTP "
			+ Строка(Ответ.КодСостояния) + ", " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьСнимок(АдресAPI, Токен, Снимок)
	Адрес = СокрЛП(АдресAPI);
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	Иначе
		ВызватьИсключение "Revora требует HTTPS";
	КонецЕсли;
	ПозицияСлэша = СтрНайти(Адрес, "/");
	Если ПозицияСлэша = 0 Тогда
		Хост = Адрес;
		БазовыйПуть = "";
	Иначе
		Хост = Лев(Адрес, ПозицияСлэша - 1);
		БазовыйПуть = Сред(Адрес, ПозицияСлэша);
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = "/" Тогда БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1); КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Снимок);
	Тело = Запись.Закрыть();
	Соединение = Новый HTTPСоединение(Хост, 443, , , , 120, Новый ЗащищенноеСоединениеOpenSSL);
	HTTPЗапрос = Новый HTTPЗапрос(БазовыйПуть + "/api/v1/integrations/1c/report-snapshot");
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Revora отклонила снимок " + Снимок.report_type + ": HTTP "
			+ Строка(Ответ.КодСостояния) + ", " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////
// ДИАГНОСТИКА 1С (v1.4.0-diagnostic, read-only), ревизия 3
//
// Отдельно от ревизии 2 (найдены и исправлены реальные дефекты):
//   - в ключевые слова области "пациенты" добавлено "контрагент" и
//     "физическ" -- в уже работающем production-коде (СинхронизироватьПериод
//     выше и ДиагностикаПациента) пациент реально приходит как
//     Выборка.Контрагент, справочник называется "Контрагенты", а слова
//     "контрагент" в ключах не было вообще -- реальный справочник пациентов
//     мог не попасть в результат диагностики;
//   - в metadata-only режиме УБРАНА фильтрация объектов по имени/синониму:
//     раньше объект, чьё имя/синоним не совпало ни с одним ключевым словом,
//     полностью пропускался ДО того, как посмотреть на его поля -- то есть
//     нейтрально названный документ/регистр с полями Пациент/Врач/Кабинет/
//     Сумма/ДатаПриема мог быть потерян целиком. Теперь экспортируются ВСЕ
//     объекты перечисленных видов метаданных без исключения; "области" --
//     это необязательная подсказка для быстрого просмотра, а не фильтр;
//   - добавлено сканирование Метаданные.Отчеты (имена, синонимы, имена
//     макетов и форм, реквизиты отчёта, если доступны) -- у же работающий
//     код использует минимум 5 отчётов (ОказанныеУслугиПоВрачу,
//     АнализОплатПоВрачам, ПациентыПосетившиеКлиникуЗаПериод,
//     СтатистикаПредварительнойЗаписи, МониторРуководителяВыручка), их
//     метаданные раньше не собирались вообще. Сами отчёты НЕ выполняются --
//     собираются только имена макетов/форм, никакие данные не читаются;
//   - объекты, для которых уже есть независимое подтверждение из
//     production-кода (5 отчётов выше и Справочник.Контрагенты), в JSON
//     дополнительно помечаются "известен_из_рабочего_bsl": true;
//   - функция сбора метаданных теперь возвращает не голый массив, а
//     структуру со счётчиками целостности сканирования: сколько объектов
//     всего просмотрено, сколько успешно описано, сколько видов метаданных
//     охвачено, сколько и какие объекты дали ошибку при сканировании --
//     чтобы по самому JSON было видно, что сканирование прошло полностью,
//     а не тихо потеряло часть объектов;
//   - массовый подсчёт агрегатов (КОЛИЧЕСТВО/МИНИМУМ/МАКСИМУМ по всем
//     найденным объектам) в этой сборке НЕ выполняется вообще: при текущей
//     синхронной реализации (последовательные серверные вызовы из одной
//     клиентской процедуры) кнопка "Отмена" не может прервать уже
//     выполняющийся тяжёлый КОЛИЧЕСТВО(*), а сам интерфейс формы может не
//     успеть обработать нажатие кнопки до завершения всей процедуры --
//     то есть это была бы обещанная, но не работающая гарантированно
//     отмена. Функция ПолучитьАгрегатыОбъекта() ниже оставлена в модуле
//     (безопасна и по-прежнему полезна), но НЕ вызывается из формы этой
//     сборки -- агрегаты будут посчитаны отдельно, позже, только по
//     короткому подтверждённому списку объектов, после того как вы
//     пришлёте этот metadata-only результат.
//
// Гарантии read-only не изменились: НИКОГДА не читается и не выгружается
// ФИО, телефон, адрес, содержимое документов, диагнозы, строки лечения --
// ни в поле, ни в табличной части, ни в макете отчёта (макеты отчётов
// перечисляются только по ИМЕНИ, содержимое макета не открывается и не
// читается). Эта сборка не делает ни одного запроса к самим данным --
// ни одного КОЛИЧЕСТВО/МИНИМУМ/МАКСИМУМ, только структура метаданных.
////////////////////////////////////////////////////////////////////////////

// Ключевые слова (регистр не важен, сравнение по НРег()) -- это ТОЛЬКО
// подсказка для быстрого просмотра результата ("области"), не фильтр:
// в metadata-only режиме экспортируются все объекты независимо от того,
// совпало что-то или нет (см. РвСканироватьКоллекцию).
Функция РвОбластиДиагностики()
	Области = Новый Структура;
	Области.Вставить("пациенты", "контрагент,физическ,физлицо,клиент,пациент,картотек");
	Области.Вставить("врачи", "врач,сотрудник,специалист,doctor,персонал");
	Области.Вставить("специальности", "специальност,профил,должност,квалифика");
	Области.Вставить("записи_на_прием", "запись,расписание,талон,бронир,график");
	Области.Вставить("визиты_посещения", "визит,посещен,прием,осмотр");
	Области.Вставить("услуги", "услуга,номенклатур,прейскурант,service,манипуляц");
	Области.Вставить("планы_лечения", "план лечения,лечебн,treatment,план_лечения");
	Области.Вставить("оплаты_начисления", "оплат,начислен,платеж,расчет,задолж,зарплат,payroll");
	Области.Вставить("расходы", "расход,затрат,expense,списан,закупк");
	Области.Вставить("касса_банк_счета", "касс,счет,банк,расчетный");
	Области.Вставить("кабинеты_помещения", "кабинет,помещен,room,зал,филиал");
	Области.Вставить("перемещения", "перемещен,transfer,перевод,движен");
	Возврат Области;
КонецФункции

// Полные имена объектов, на которые уже есть независимое подтверждение из
// работающего production-кода этого же расширения (см. СинхронизироватьПериод
// выше и ДиагностикаПациента) -- отмечаются в результате отдельным флагом,
// это не влияет на то, что попадает в JSON (попадает всё), только на пометку.
Функция РвИзвестныеОбъекты()
	Известные = Новый Массив;
	Известные.Добавить("Справочник.Контрагенты");
	Известные.Добавить("Отчет.ОказанныеУслугиПоВрачу");
	Известные.Добавить("Отчет.АнализОплатПоВрачам");
	Известные.Добавить("Отчет.ПациентыПосетившиеКлиникуЗаПериод");
	Известные.Добавить("Отчет.СтатистикаПредварительнойЗаписи");
	Известные.Добавить("Отчет.МониторРуководителяВыручка");
	Возврат Известные;
КонецФункции

Функция РвСодержитКлючевоеСлово(ТекстДляПоиска, СписокКлючевыхСлов)
	Слова = СтрРазделить(СписокКлючевыхСлов, ",", Ложь);
	Для Каждого Слово Из Слова Цикл
		Обработанное = СокрЛП(Слово);
		Если ПустаяСтрока(Обработанное) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ТекстДляПоиска, Обработанное) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция РвПредставлениеОдногоТипа(ТекТип)
	Если ТекТип = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТекТип = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТекТип = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТекТип = Тип("Булево") Тогда
		Возврат "Булево";
	Иначе
		Попытка
			МетаОбъект = Метаданные.НайтиПоТипу(ТекТип);
			Если МетаОбъект <> Неопределено Тогда
				Возврат МетаОбъект.ПолноеИмя();
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат "Ссылка";
	КонецЕсли;
КонецФункции

Функция РвПредставлениеТипа(ОписаниеТипов)
	Имена = Новый Массив;
	Для Каждого ТекТип Из ОписаниеТипов.Типы() Цикл
		Имена.Добавить(РвПредставлениеОдногоТипа(ТекТип));
	КонецЦикла;
	Возврат СтрСоединить(Имена, "|");
КонецФункции

Процедура РвДобавитьПоляКоллекции(Коллекция, Категория, СписокПолей)
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Попытка
			Поле = Новый Структура;
			Поле.Вставить("категория", Категория);
			Поле.Вставить("имя", ЭлементКоллекции.Имя);
			Поле.Вставить("синоним", Строка(ЭлементКоллекции.Синоним));
			Поле.Вставить("тип", РвПредставлениеТипа(ЭлементКоллекции.Тип));
			Поле.Вставить("тип_содержит_дату", ЭлементКоллекции.Тип.СодержитТип(Тип("Дата")));
			СписокПолей.Добавить(Поле);
		Исключение
			// один нечитаемый элемент коллекции не должен ронять весь объект
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура РвДобавитьСтандартноеПоле(СписокПолей, Имя, Тип, СодержитДату)
	Поле = Новый Структура;
	Поле.Вставить("категория", "стандартное");
	Поле.Вставить("имя", Имя);
	Поле.Вставить("синоним", Имя);
	Поле.Вставить("тип", Тип);
	Поле.Вставить("тип_содержит_дату", СодержитДату);
	СписокПолей.Добавить(Поле);
КонецПроцедуры

Процедура РвДобавитьСтандартныеПоляРегистра(Объект, ТипКоллекции, СписокПолей)
	Если ТипКоллекции = "РегистрСведений" Тогда
		Попытка
			// Системные перечисления метаданных называются по-разному в
			// разных режимах совместимости 1С. Сравниваем без жёсткой
			// ссылки на глобальное перечисление, которого может не быть.
			ПериодичностьСтрокой = НРег(Строка(Объект.Периодичность));
			Если СтрНайти(ПериодичностьСтрокой, "непериод") = 0 Тогда
				РвДобавитьСтандартноеПоле(СписокПолей, "Период", "Дата", Истина);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			РежимЗаписиСтрокой = НРег(Строка(Объект.РежимЗаписи));
			Если СтрНайти(РежимЗаписиСтрокой, "подчин") > 0 Тогда
				РвДобавитьСтандартноеПоле(СписокПолей, "Регистратор", "Ссылка (Документ)", Ложь);
				РвДобавитьСтандартноеПоле(СписокПолей, "НомерСтроки", "Число", Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипКоллекции = "РегистрНакопления" Тогда
		РвДобавитьСтандартноеПоле(СписокПолей, "Период", "Дата", Истина);
		РвДобавитьСтандартноеПоле(СписокПолей, "Регистратор", "Ссылка (Документ)", Ложь);
		РвДобавитьСтандартноеПоле(СписокПолей, "НомерСтроки", "Число", Ложь);
		РвДобавитьСтандартноеПоле(СписокПолей, "Активность", "Булево", Ложь);
		Попытка
			ВидРегистраСтрокой = НРег(Строка(Объект.ВидРегистра));
			Если СтрНайти(ВидРегистраСтрокой, "остат") > 0 Тогда
				РвДобавитьСтандартноеПоле(СписокПолей, "ВидДвижения", "ВидДвиженияНакопления (Приход|Расход)", Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипКоллекции = "РегистрБухгалтерии" Или ТипКоллекции = "РегистрРасчета" Тогда
		Попытка
			РвДобавитьСтандартноеПоле(СписокПолей, "Период", "Дата", Истина);
			РвДобавитьСтандартноеПоле(СписокПолей, "Регистратор", "Ссылка (Документ)", Ложь);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Функция РвТабличныеЧастиОбъекта(Объект)
	Результат = Новый Массив;
	Попытка
		Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
			Попытка
				Описание = Новый Структура;
				Описание.Вставить("имя", ТЧ.Имя);
				Описание.Вставить("синоним", Строка(ТЧ.Синоним));
				РеквизитыТЧ = Новый Массив;
				РвДобавитьПоляКоллекции(ТЧ.Реквизиты, "реквизит", РеквизитыТЧ);
				Описание.Вставить("реквизиты", РеквизитыТЧ);
				Результат.Добавить(Описание);
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция РвЗначенияПеречисления(Объект)
	Результат = Новый Массив;
	Попытка
		Для Каждого Значение Из Объект.ЗначенияПеречисления Цикл
			Попытка
				Результат.Добавить(Новый Структура("имя,синоним", Значение.Имя, Строка(Значение.Синоним)));
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Метаданные-описание одного объекта отчёта: имя, синоним, имена макетов и
// форм, реквизиты отчёта (если платформа их предоставляет для данного вида
// отчёта -- обычные отчёты на СКД могут их не иметь, тогда список пустой).
// Отчёт НЕ выполняется, макет не открывается -- только перечисление имён.
Функция РвОписаниеОтчета(Объект)
	Описание = Новый Структура;
	Описание.Вставить("тип", "Отчет");
	Описание.Вставить("имя", Объект.Имя);
	Описание.Вставить("синоним", Строка(Объект.Синоним));
	Попытка
		Описание.Вставить("полное_имя", Объект.ПолноеИмя());
	Исключение
		Описание.Вставить("полное_имя", "Отчет." + Объект.Имя);
	КонецПопытки;

	Макеты = Новый Массив;
	Попытка
		Для Каждого Макет Из Объект.Макеты Цикл
			Попытка
				Макеты.Добавить(Новый Структура("имя,синоним", Макет.Имя, Строка(Макет.Синоним)));
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Описание.Вставить("макеты", Макеты);

	Формы = Новый Массив;
	Попытка
		Для Каждого Форма Из Объект.Формы Цикл
			Попытка
				Формы.Добавить(Новый Структура("имя,синоним", Форма.Имя, Строка(Форма.Синоним)));
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Описание.Вставить("формы", Формы);

	РеквизитыОтчета = Новый Массив;
	Попытка
		РвДобавитьПоляКоллекции(Объект.Реквизиты, "реквизит", РеквизитыОтчета);
	Исключение
		// у многих отчётов (в частности СКД) реквизитов на уровне метаданных
		// нет вообще -- это нормально, не ошибка
	КонецПопытки;
	Описание.Вставить("поля", РеквизитыОтчета); // для единообразия с другими объектами
	Описание.Вставить("табличные_части", Новый Массив);
	Описание.Вставить("кандидаты_полей_даты", Новый Массив);
	Описание.Вставить("основное_поле_даты", Неопределено);

	Возврат Описание;
КонецФункции

Функция РвОписаниеОбъектаМетаданные(Объект, ТипКоллекции)
	Описание = Новый Структура;
	Описание.Вставить("тип", ТипКоллекции);
	Описание.Вставить("имя", Объект.Имя);
	Описание.Вставить("синоним", Строка(Объект.Синоним));

	Попытка
		Описание.Вставить("полное_имя", Объект.ПолноеИмя());
	Исключение
		Описание.Вставить("полное_имя", ТипКоллекции + "." + Объект.Имя);
	КонецПопытки;

	СписокПолей = Новый Массив;
	Попытка
		Если ТипКоллекции = "РегистрСведений" Или ТипКоллекции = "РегистрНакопления"
			Или ТипКоллекции = "РегистрБухгалтерии" Или ТипКоллекции = "РегистрРасчета" Тогда
			РвДобавитьПоляКоллекции(Объект.Измерения, "измерение", СписокПолей);
			РвДобавитьПоляКоллекции(Объект.Ресурсы, "ресурс", СписокПолей);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если ТипКоллекции = "Перечисление" Тогда
		Описание.Вставить("значения", РвЗначенияПеречисления(Объект));
	Иначе
		Попытка
			РвДобавитьПоляКоллекции(Объект.Реквизиты, "реквизит", СписокПолей);
		Исключение
		КонецПопытки;
	КонецЕсли;

	РвДобавитьСтандартныеПоляРегистра(Объект, ТипКоллекции, СписокПолей);

	Если ТипКоллекции = "Документ" Тогда
		РвДобавитьСтандартноеПоле(СписокПолей, "Дата", "Дата", Истина);
	КонецЕсли;

	Описание.Вставить("поля", СписокПолей);
	Описание.Вставить("табличные_части", РвТабличныеЧастиОбъекта(Объект));

	КандидатыДат = Новый Массив;
	Для Каждого Поле Из СписокПолей Цикл
		Если Поле.тип_содержит_дату Тогда
			КандидатыДат.Добавить(Поле.имя);
		КонецЕсли;
	КонецЦикла;
	Описание.Вставить("кандидаты_полей_даты", КандидатыДат);

	ОсновноеПолеДаты = Неопределено;
	Если ТипКоллекции = "Документ" Тогда
		ОсновноеПолеДаты = "Дата";
	ИначеЕсли КандидатыДат.Найти("Период") <> Неопределено Тогда
		ОсновноеПолеДаты = "Период";
	ИначеЕсли КандидатыДат.Количество() > 0 И КандидатыДат.Количество() <= 3 Тогда
		ОсновноеПолеДаты = КандидатыДат[0];
	КонецЕсли;
	Описание.Вставить("основное_поле_даты", ОсновноеПолеДаты);

	Возврат Описание;
КонецФункции

// Сканирует одну коллекцию метаданных и добавляет описание КАЖДОГО объекта
// (исправлено -- в ревизии 2 объекты без совпадения ключевого слова
// пропускались целиком; теперь "области" -- необязательная подсказка,
// экспортируется всё). Счётчики Всего/Ошибок обновляются по ссылке через
// Структуру Счётчики, чтобы вызывающая функция знала точный итог сканирования.
Процедура РвСканироватьКоллекцию(Коллекция, ТипКоллекции, НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики)
	Для Каждого Объект Из Коллекция Цикл
		Счётчики.Всего = Счётчики.Всего + 1;
		Попытка
			Если ТипКоллекции = "Отчет" Тогда
				Описание = РвОписаниеОтчета(Объект);
			Иначе
				Описание = РвОписаниеОбъектаМетаданные(Объект, ТипКоллекции);
			КонецЕсли;

			ТекстДляПоиска = НРег(Объект.Имя + " " + Строка(Объект.Синоним));
			СовпавшиеОбласти = Новый Массив;
			Для Каждого ОбластьКлючЗначение Из Области Цикл
				Если РвСодержитКлючевоеСлово(ТекстДляПоиска, ОбластьКлючЗначение.Значение) Тогда
					СовпавшиеОбласти.Добавить(ОбластьКлючЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
			Описание.Вставить("области", СовпавшиеОбласти);
			Описание.Вставить("известен_из_рабочего_bsl", ИзвестныеОбъекты.Найти(Описание.полное_имя) <> Неопределено);

			НайденныеОбъекты.Добавить(Описание);
		Исключение
			ОшибочнаяЗапись = Новый Структура;
			ОшибочнаяЗапись.Вставить("тип", ТипКоллекции);
			ОшибочнаяЗапись.Вставить("имя", Объект.Имя);
			ОшибочнаяЗапись.Вставить("ошибка_сканирования", ОписаниеОшибки());
			ОшибкиСканирования.Добавить(ОшибочнаяЗапись);
			Счётчики.Ошибок = Счётчики.Ошибок + 1;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// СТАДИЯ 1 (единственная в этой сборке): полный metadata-only каталог, без
// единого обращения к данным. Возвращает Структуру (не голый массив, как в
// ревизии 2) со счётчиками целостности сканирования -- см. заголовок файла.
Функция СобратьДиагностикуМетаданные() Экспорт
	Области = РвОбластиДиагностики();
	ИзвестныеОбъекты = РвИзвестныеОбъекты();
	НайденныеОбъекты = Новый Массив;
	ОшибкиСканирования = Новый Массив;
	Счётчики = Новый Структура("Всего,Ошибок", 0, 0);

	ВидыМетаданных = Новый Массив;
	ВидыМетаданных.Добавить("Справочник");
	ВидыМетаданных.Добавить("Документ");
	ВидыМетаданных.Добавить("РегистрСведений");
	ВидыМетаданных.Добавить("РегистрНакопления");
	ВидыМетаданных.Добавить("РегистрБухгалтерии");
	ВидыМетаданных.Добавить("РегистрРасчета");
	ВидыМетаданных.Добавить("ПланВидовРасчета");
	ВидыМетаданных.Добавить("ПланСчетов");
	ВидыМетаданных.Добавить("Перечисление");
	ВидыМетаданных.Добавить("Отчет");

	РвСканироватьКоллекцию(Метаданные.Справочники, "Справочник", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.Документы, "Документ", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.РегистрыСведений, "РегистрСведений", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.РегистрыНакопления, "РегистрНакопления", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.РегистрыРасчета, "РегистрРасчета", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.ПланыВидовРасчета, "ПланВидовРасчета", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.ПланыСчетов, "ПланСчетов", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.Перечисления, "Перечисление", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);
	РвСканироватьКоллекцию(Метаданные.Отчеты, "Отчет", НайденныеОбъекты, ОшибкиСканирования, Области, ИзвестныеОбъекты, Счётчики);

	Результат = Новый Структура;
	Результат.Вставить("объекты", НайденныеОбъекты);
	Результат.Вставить("ошибки_сканирования", ОшибкиСканирования);
	Результат.Вставить("total_metadata_objects_scanned", Счётчики.Всего);
	Результат.Вставить("total_objects_exported", НайденныеОбъекты.Количество());
	Результат.Вставить("scan_errors_count", Счётчики.Ошибок);
	Результат.Вставить("object_types_scanned", ВидыМетаданных);
	Возврат Результат;
КонецФункции

// Безопасные значения об окружении для верхнего уровня JSON -- НИКОГДА не
// включает имя пользователя, имя компьютера, строку соединения или путь к
// базе (см. README): только версия платформы, имя/версия конфигурации и
// версия расширения, все три через отдельные Попытка/Исключение.
Функция СобратьСведенияОкруженияДляДиагностики() Экспорт
	Сведения = Новый Структура;

	Попытка
		СистИнфо = Новый СистемнаяИнформация;
		Сведения.Вставить("platform_version", СистИнфо.ВерсияПриложения);
	Исключение
		Сведения.Вставить("platform_version", "неизвестно");
	КонецПопытки;

	Попытка
		Сведения.Вставить("configuration_name", Метаданные.Имя);
	Исключение
		Сведения.Вставить("configuration_name", "неизвестно");
	КонецПопытки;

	Попытка
		Сведения.Вставить("configuration_version", Метаданные.Версия);
	Исключение
		Сведения.Вставить("configuration_version", "неизвестно");
	КонецПопытки;

	Возврат Сведения;
КонецФункции

// СТАДИЯ 2 (НЕ используется формой этой сборки -- см. заголовок файла).
// Оставлена в модуле для будущего точечного использования по короткому
// подтверждённому списку объектов, а не как часть массового сканирования.
Функция ПолучитьАгрегатыОбъекта(ПолноеИмя, ИмяПоляДаты) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("полное_имя", ПолноеИмя);
	Результат.Вставить("количество_записей", Неопределено);
	Результат.Вставить("поле_даты", ИмяПоляДаты);
	Результат.Вставить("мин_дата", Неопределено);
	Результат.Вставить("макс_дата", Неопределено);
	Результат.Вставить("ошибка", Неопределено);

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Вставить("количество_записей", Выборка.Кол);
		КонецЕсли;
	Исключение
		Результат.Вставить("ошибка", ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если ЗначениеЗаполнено(ИмяПоляДаты) Тогда
		Попытка
			ЗапросДат = Новый Запрос(
				"ВЫБРАТЬ МИНИМУМ(" + ИмяПоляДаты + ") КАК Мин, МАКСИМУМ(" + ИмяПоляДаты + ") КАК Макс ИЗ " + ПолноеИмя);
			ВыборкаДат = ЗапросДат.Выполнить().Выбрать();
			Если ВыборкаДат.Следующий() Тогда
				Результат.Вставить("мин_дата", ВыборкаДат.Мин);
				Результат.Вставить("макс_дата", ВыборкаДат.Макс);
			КонецЕсли;
		Исключение
			Результат.Вставить("ошибка_диапазона_дат", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;
КонецФункции
