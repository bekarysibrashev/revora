	HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Revora отклонила снимок " + Снимок.report_type + ": HTTP "
			+ Строка(Ответ.КодСостояния) + ", " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
КонецПроцедуры
