Функция СформироватьЗарплату(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Расчеты.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Расчеты.Сотрудник КАК Сотрудник,
	|	СУММА(Расчеты.СуммаПриход) КАК Начислено,
	|	СУММА(Расчеты.СуммаРасход) КАК Выплачено
	|ИЗ
	|	РегистрНакопления.РасчетыСПерсоналом.ОстаткиИОбороты(
	|		, , Авто, ,
	|		МесяцНачисления >= НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ)
	|			И МесяцНачисления <= НАЧАЛОПЕРИОДА(&КонецПериода, МЕСЯЦ)) КАК Расчеты
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.СтруктурнаяЕдиница,
	|	Расчеты.Сотрудник";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода + 1);

	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	ИтогоНачислено = 0;
	ИтогоВыплачено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
		Начислено = Число0(Выборка.Начислено);
		Выплачено = Число0(Выборка.Выплачено);
		Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Строка(Выборка.СтруктурнаяЕдиница));
		Группа.Сумма = Группа.Сумма + Начислено;
		Группа.Выплачено = Группа.Выплачено + Выплачено;
		ИтогоНачислено = ИтогоНачислено + Начислено;
		ИтогоВыплачено = ИтогоВыплачено + Выплачено;
		ДобавитьМетрику(Метрики, "payroll_accrual", "employee", КлючСсылки(Выборка.Сотрудник),
			Строка(Выборка.Сотрудник), Начислено, "KZT", КлючФилиала);
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "payroll_accrual", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "payroll_paid", "branch", Элемент.Ключ, Группа.Наименование,
			Группа.Выплачено, "KZT", Элемент.Ключ);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "payroll_accrual", "clinic", "clinic", "Вся клиника", ИтогоНачислено, "KZT");
	ДобавитьМетрику(Метрики, "payroll_paid", "clinic", "clinic", "Вся клиника", ИтогоВыплачено, "KZT");
	ДобавитьМетрику(Метрики, "payroll_due", "clinic", "clinic", "Вся клиника", ИтогоНачислено - ИтогоВыплачено, "KZT");
	Возврат НовыйСнимок("payroll", НачалоПериода, КонецПериода, Метрики);

КонецФункции

Функция СформироватьПоступления(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Поступление.Ссылка КАК Документ,
	|	Поступление.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Поступление.СуммаДокумента КАК Сумма,
	|	Поступление.СуммаОплачено КАК Оплачено
	|ИЗ
	|	Документ.Поступление КАК Поступление
	|ГДЕ
	|	Поступление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Поступление.ПометкаУдаления
	|	И Поступление.Проведен";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Метрики = Новый Массив;
	Филиалы = Новый Соответствие;
	ИтогоВсе = 0;
	ИтогоОплаченоВсе = 0;
	ИтогоСАН = 0;
	ИтогоОплаченоСАН = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сумма = Число0(Выборка.Сумма);
		Оплачено = Число0(Выборка.Оплачено);
		ИтогоВсе = ИтогоВсе + Сумма;
		ИтогоОплаченоВсе = ИтогоОплаченоВсе + Оплачено;
		Наименование = Строка(Выборка.СтруктурнаяЕдиница);
		Если СтрНачинаетсяС(ВРег(СокрЛП(Наименование)), "SAN (") Тогда
			КлючФилиала = КлючСсылки(Выборка.СтруктурнаяЕдиница);
			Группа = ПолучитьГруппу(Филиалы, КлючФилиала, Наименование);
			Группа.Сумма = Группа.Сумма + Сумма;
			Группа.Выплачено = Группа.Выплачено + Оплачено;
			ИтогоСАН = ИтогоСАН + Сумма;
			ИтогоОплаченоСАН = ИтогоОплаченоСАН + Оплачено;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Филиалы Цикл
		Группа = Элемент.Значение;
		ДобавитьМетрику(Метрики, "purchases_accrual", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.Сумма, "KZT", Элемент.Ключ);
		ДобавитьМетрику(Метрики, "purchases_paid", "branch", Элемент.Ключ,
			Группа.Наименование, Группа.Выплачено, "KZT", Элемент.Ключ);
	КонецЦикла;
	ДобавитьМетрику(Метрики, "purchases_accrual_all_entities", "clinic", "clinic", "Все юрлица", ИтогоВсе, "KZT");
	ДобавитьМетрику(Метрики, "purchases_paid_all_entities", "clinic", "clinic", "Все юрлица", ИтогоОплаченоВсе, "KZT");
	ДобавитьМетрику(Метрики, "purchases_accrual", "clinic", "clinic", "SAN Dental", ИтогоСАН, "KZT");
	ДобавитьМетрику(Метрики, "purchases_paid", "clinic", "clinic", "SAN Dental", ИтогоОплаченоСАН, "KZT");
	Возврат НовыйСнимок("purchases", НачалоПериода, КонецПериода, Метрики);

