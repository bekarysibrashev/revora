&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресAPI = "https://revora-san-api-0sj5.onrender.com";
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	КонецПериода = КонецМесяца(НачалоПериода);
	Состояние = "Укажите токен коннектора и период, затем нажмите «Синхронизировать».";

	Настройки = ХранилищеСистемныхНастроек.Загрузить("Revora/Обмен");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("АдресAPI", АдресAPI);
		Настройки.Свойство("Токен", Токен);
		Настройки.Свойство("НачалоПериода", НачалоПериода);
		Настройки.Свойство("КонецПериода", КонецПериода);
	КонецЕсли;

	// Показываем результат последнего АВТОМАТИЧЕСКОГО (почасового) запуска,
	// если регламентное задание включено и хотя бы раз срабатывало --
	// ручную синхронизацию это не заменяет и не блокирует.
	Журнал = РвОбменСервер.ПолучитьЖурналПочасовойСинхронизации();
	Если ТипЗнч(Журнал) = Тип("Структура") Тогда
		ПоследнийУспехВ = Неопределено;
		Журнал.Свойство("ПоследнийУспехВ", ПоследнийУспехВ);
		ПоследняяОшибка = Неопределено;
		Журнал.Свойство("ПоследняяОшибка", ПоследняяОшибка);
		Если ПоследняяОшибка <> Неопределено Тогда
			Состояние = Состояние + Символы.ПС + Символы.ПС
				+ "Последний автоматический запуск завершился ошибкой: " + ПоследняяОшибка;
		ИначеЕсли ПоследнийУспехВ <> Неопределено Тогда
			Состояние = Состояние + Символы.ПС + Символы.ПС
				+ "Последняя автоматическая синхронизация: " + Формат(ПоследнийУспехВ, "ДФ=yyyy-MM-dd HH:mm:ss");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)
	Состояние = "Формируем контрольные и дневные снимки…";
	Попытка
		Состояние = ВыполнитьСинхронизациюНаСервере();
		Сообщить(Состояние);
	Исключение
		Состояние = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(Состояние, СтатусСообщения.Важное);
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ВыполнитьСинхронизациюНаСервере()
	Если ПустаяСтрока(СокрЛП(АдресAPI)) Тогда
		ВызватьИсключение "Не указан адрес API Revora";
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Токен)) Тогда
		ВызватьИсключение "Не указан токен коннектора Revora";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		ВызватьИсключение "Укажите начало и конец периода";
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		ВызватьИсключение "Начало периода позже окончания";
	КонецЕсли;

	Настройки = Новый Структура("АдресAPI,Токен,НачалоПериода,КонецПериода",
		АдресAPI, Токен, НачалоПериода, КонецПериода);
	ХранилищеСистемныхНастроек.Сохранить("Revora/Обмен",, Настройки);

	Итоги = РвОбменСервер.СинхронизироватьПериод(НачалоПериода, КонецПериода, АдресAPI, Токен);
	Возврат РвОбменСервер.ПредставлениеИтоговСинхронизации(Итоги);
КонецФункции
