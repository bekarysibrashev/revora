# Application
APP_NAME=Revora API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Almaty
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=revora
POSTGRES_USER=revora
POSTGRES_PASSWORD=revora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://revora:revora@postgres:5432/revora

# Redis / Celery
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
FLOWER_PORT=5555

# MinIO
MINIO_ROOT_USER=revora
MINIO_ROOT_PASSWORD=revora-local-secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=revora
MINIO_SECRET_KEY=revora-local-secret
MINIO_SECURE=false
MINIO_BUCKET=revora
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth — replace before any shared deployment
JWT_SECRET_KEY=local-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Kcell Virtual PBX callback (set a unique value in Kcell and in Render)
KCELL_CRM_TOKEN=
KCELL_TENANT_SLUG=demo

# Browser clients; JSON or comma-separated list is accepted
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
NEXT_PUBLIC_API_URL=/api/v1

# Provider for the role-scoped Data Science Lab. Groq keeps the pilot cheap;
# deterministic Revora tools, rather than the model, calculate all numbers.
ANALYST_AI_PROVIDER=groq
ANALYST_AI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq powers call transcription and structured call-quality reports.
CALL_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
CALL_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CALL_ANALYSIS_MODEL=openai/gpt-oss-20b
CALL_MIN_DURATION_SECONDS=7
CALL_MAX_AUDIO_BYTES=25000000
CALL_ANALYSIS_TIMEOUT_SECONDS=120
CALL_ANALYSIS_MAX_ATTEMPTS=3
EMBEDDED_CALL_WORKER=false
EMBEDDED_CALL_WORKER_INTERVAL_SECONDS=20
EMBEDDED_CALL_PROCESSING_TIMEOUT_MINUTES=15
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOOL_ROUNDS=4
AI_MESSAGES_PER_MINUTE=10

# WhatsApp Cloud API. Keep auto-send disabled until the clinic completes a pilot.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DATA_KEY=
META_APP_ID=965678616515017
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=2277685509673688
WHATSAPP_TENANT_SLUG=demo
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_AI_PROVIDER=rules
WHATSAPP_AI_MODEL=openai/gpt-oss-20b
WHATSAPP_AI_AUTO_SEND=false
WHATSAPP_MONTHLY_BUDGET_KZT=10000
WHATSAPP_MAX_CONTEXT_MESSAGES=12
WHATSAPP_USD_KZT_RATE=550
